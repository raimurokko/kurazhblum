---
import { asset, path, t, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';
import type { I18nText } from '../i18n/config';

type Topic = 'wedding' | 'event' | 'workshop' | 'general';

interface Props {
  lang: Locale;
  topic: Topic;
  /** Vorbelegung, z. B. der gewählte Workshop. */
  subject?: string;
}

const { lang, topic, subject = '' } = Astro.props;
const _ = useTranslations(lang);

/** Nur für Hochzeiten und Events relevant. */
const showEventFields = topic === 'wedding' || topic === 'event';
const showGuestFields = showEventFields || topic === 'workshop';

/** Galas Staffel — sie beginnt bei 1.000 € und deckelt bei 10.000 €. */
const budgets: { value: string; label: I18nText }[] = [
  {
    value: '1000-1500',
    label: { de: '1.000 – 1.500 €', uk: '1 000 – 1 500 €', en: '€1,000 – 1,500', ru: '1 000 – 1 500 €' },
  },
  {
    value: '1500-3000',
    label: { de: '1.500 – 3.000 €', uk: '1 500 – 3 000 €', en: '€1,500 – 3,000', ru: '1 500 – 3 000 €' },
  },
  {
    value: '3000-5000',
    label: { de: '3.000 – 5.000 €', uk: '3 000 – 5 000 €', en: '€3,000 – 5,000', ru: '3 000 – 5 000 €' },
  },
  {
    value: '5000-10000',
    label: { de: '5.000 – 10.000 €', uk: '5 000 – 10 000 €', en: '€5,000 – 10,000', ru: '5 000 – 10 000 €' },
  },
  {
    value: 'offen',
    label: { de: 'noch offen', uk: 'ще не визначено', en: 'not decided yet', ru: 'пока не решено' },
  },
];

const weddingServices: { value: string; label: I18nText }[] = [
  {
    value: 'brautstrauss',
    label: {
      de: 'Brautstrauß & Anstecker für den Bräutigam',
      uk: 'Букет нареченої та бутоньєрка для нареченого',
      en: 'Bridal bouquet & buttonhole for the groom',
      ru: 'Букет невесты и бутоньерки для жениха',
    },
  },
  {
    value: 'bogen',
    label: { de: 'Hochzeitsbogen', uk: 'Весільна арка', en: 'Wedding arch', ru: 'Свадебная арка' },
  },
  {
    value: 'tische',
    label: {
      de: 'Florale Tischgestaltung',
      uk: 'Флористичне оформлення столів',
      en: 'Floral table design',
      ru: 'Флористическое оформление столов',
    },
  },
  {
    value: 'fotozone',
    label: { de: 'Fotozone', uk: 'Фотозона', en: 'Photo backdrop', ru: 'Фотозона' },
  },
  {
    value: 'abbau',
    label: { de: 'Auf- und Abbau', uk: 'Монтаж і демонтаж', en: 'Set-up & take-down', ru: 'Монтаж и демонтаж' },
  },
];

/*
  Berlins zwölf Bezirke. Beim Workshop vor Ort entscheidet der Bezirk über die
  Zone und damit über die Anfahrt — deshalb fragt das Formular ihn ab, statt
  eine Adresse zu verlangen, die zum Zeitpunkt der Anfrage oft noch gar nicht
  feststeht. Die Postleitzahlen stehen dabei, weil viele ihre PLZ sicherer
  wissen als den amtlichen Bezirksnamen.
*/
const berlinDistricts: { value: string; label: string }[] = [
  { value: 'mitte', label: 'Mitte (10115 – 13359)' },
  { value: 'friedrichshain-kreuzberg', label: 'Friedrichshain-Kreuzberg (10243 – 10999)' },
  { value: 'pankow', label: 'Pankow (10405 – 13189)' },
  { value: 'charlottenburg-wilmersdorf', label: 'Charlottenburg-Wilmersdorf (10585 – 14199)' },
  { value: 'spandau', label: 'Spandau (13581 – 13629)' },
  { value: 'steglitz-zehlendorf', label: 'Steglitz-Zehlendorf (12157 – 14169)' },
  { value: 'tempelhof-schoeneberg', label: 'Tempelhof-Schöneberg (10777 – 12309)' },
  { value: 'neukoelln', label: 'Neukölln (12043 – 12359)' },
  { value: 'treptow-koepenick', label: 'Treptow-Köpenick (12435 – 12689)' },
  { value: 'marzahn-hellersdorf', label: 'Marzahn-Hellersdorf (12619 – 12689)' },
  { value: 'lichtenberg', label: 'Lichtenberg (10315 – 13059)' },
  { value: 'reinickendorf', label: 'Reinickendorf (13403 – 13629)' },
];
---

<form
  class="inq panel"
  data-inquiry
  data-topic={topic}
  data-busy-label={_('form.sending')}
  data-endpoint={asset('/api/inquiry')}
>
  <input type="hidden" name="topic" value={topic} />
  <input type="hidden" name="lang" value={lang} />
  {subject && <input type="hidden" name="subject" value={subject} />}

  <!-- Honeypot: für Menschen unsichtbar, Bots füllen es aus. -->
  <div class="hp" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <p class="hint inq-required">{_('form.required.note')}</p>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.firstname')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="text" name="firstName" required autocomplete="given-name" />
    </label>

    <label class="field">
      <span class="field-label">{_('form.lastname')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="text" name="lastName" required autocomplete="family-name" />
    </label>
  </div>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.email')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="email" name="email" required autocomplete="email" />
    </label>

    <label class="field">
      <span class="field-label">{_('form.phone')} <span class="muted">({_('form.optional')})</span></span>
      <input class="input" type="tel" name="phone" autocomplete="tel" />
    </label>
  </div>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.date')} {showEventFields && <span class="req" aria-hidden="true">*</span>}</span>
      <input class="input" type="date" name="date" required={showEventFields} />
    </label>

    {
      showGuestFields && (
        <label class="field">
          <span class="field-label">{_('form.guests')}</span>
          <input class="input" type="number" name="guests" min="1" max="500" inputmode="numeric" />
        </label>
      )
    }
  </div>

  {
    showEventFields && (
      <div class="inq-row">
        <label class="field">
          <span class="field-label">{_('form.location')}</span>
          <input class="input" type="text" name="location" />
        </label>

        <label class="field">
          <span class="field-label">{_('form.budget')}</span>
          <select class="select" name="budget">
            {budgets.map((budget) => (
              <option value={budget.value}>{t(budget.label, lang)}</option>
            ))}
          </select>
        </label>
      </div>
    )
  }

  {
    topic === 'workshop' && (
      <label class="field">
        <span class="field-label">{_('form.district')}</span>
        <select class="select" name="district">
          <option value="">—</option>
          {berlinDistricts.map((district) => (
            <option value={district.value}>{district.label}</option>
          ))}
        </select>
      </label>
    )
  }

  {
    topic === 'wedding' && (
      <fieldset class="field">
        <legend class="field-label">{_('form.services')}</legend>
        <div class="choices choices--row">
          {weddingServices.map((service) => (
            <label class="choice choice--inline">
              <input type="checkbox" name="services" value={service.value} />
              <span class="choice-title">{t(service.label, lang)}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <label class="field">
    <span class="field-label">{_('form.message')} <span class="req" aria-hidden="true">*</span></span>
    <textarea class="textarea" name="message" required placeholder={_('form.message.placeholder')}></textarea>
  </label>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span class="small">
      <Fragment set:html={_('form.privacy', {
        link: `<a href="${path(lang, 'datenschutz')}">${_('form.privacy.link')}</a>`,
      })} />
    </span>
  </label>

  <button class="btn btn--primary" type="submit" data-submit>{_('form.submit')}</button>

  <p class="inq-note inq-note--ok" hidden data-success>{_('form.success')}</p>
  <p class="inq-note inq-note--error" hidden data-error>
    {_('form.error')}<br />
    <a href={`mailto:${site.email}`}>{site.email}</a>
    {site.whatsapp && (
      <>
        {' · '}
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
          {_('channels.whatsapp')}
        </a>
      </>
    )}
  </p>
</form>

<style>
  /* Der Stern ist rein visuell — `required` sagt es assistiver Technik
     ohnehin, ein vorgelesenes „Stern“ wäre nur Lärm. Deshalb aria-hidden. */
  .req {
    color: var(--gold-lit);
  }

  .inq-required {
    margin-bottom: var(--space-5);
  }

  .inq-row {
    display: grid;
    gap: var(--space-4);
    /* px statt rem: In einem Grid ohne feste Breite kann `100%` nicht
       aufgelöst werden, dann gewinnt der rem-Wert — und der wächst mit der
       eingestellten Textgröße mit. */
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  }

  .inq fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-5);
    /* Fieldsets ignorieren sonst die Breite ihres Grid-Containers. */
    min-width: 0;
  }

  .inq .choice--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .inq fieldset legend {
    padding: 0;
    margin-bottom: var(--space-3);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: var(--space-5);
    cursor: pointer;
  }

  .consent input {
    margin-top: 0.25rem;
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    accent-color: var(--gold-lit);
  }

  .inq-note {
    margin: var(--space-4) 0 0;
    padding: 0.85rem 1.1rem;
    border-left: 2px solid var(--gold);
    background: rgb(144 112 64 / 0.12);
    font-size: 0.9rem;
  }

  .inq-note--error {
    border-left-color: var(--mauve-deep);
    background: rgb(142 112 120 / 0.14);
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-inquiry]')) {
    const submitEl = form.querySelector<HTMLButtonElement>('[data-submit]');
    const successEl = form.querySelector<HTMLElement>('[data-success]');
    const errorEl = form.querySelector<HTMLElement>('[data-error]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const label = submitEl?.textContent ?? '';
      if (submitEl) {
        submitEl.disabled = true;
        submitEl.textContent = form.dataset.busyLabel ?? label;
      }
      if (errorEl) errorEl.hidden = true;

      const payload = Object.fromEntries(new FormData(form).entries());
      // Mehrfachauswahl geht bei Object.fromEntries verloren — separat nachtragen.
      const services = new FormData(form).getAll('services').map(String);

      try {
        const response = await fetch(form.dataset.endpoint ?? '/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, services }),
        });
        if (!response.ok) throw new Error(`inquiry failed: ${response.status}`);

        form.reset();
        if (successEl) successEl.hidden = false;
        if (submitEl) submitEl.hidden = true;
        successEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        console.error(error);
        if (errorEl) errorEl.hidden = false;
        if (submitEl) {
          submitEl.disabled = false;
          submitEl.textContent = label;
        }
      }
    });
  }
</script>
