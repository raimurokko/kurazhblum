---
import { asset, path, t, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';
import type { I18nText } from '../i18n/config';

type Topic = 'wedding' | 'event' | 'workshop' | 'general';

interface Props {
  lang: Locale;
  topic: Topic;
  /** Vorbelegung, z. B. der gewählte Workshop. */
  subject?: string;
}

const { lang, topic, subject = '' } = Astro.props;
const _ = useTranslations(lang);

/** Nur für Hochzeiten und Events relevant. */
const showEventFields = topic === 'wedding' || topic === 'event';
const showGuestFields = showEventFields || topic === 'workshop';

/*
  Budgetstufen mit ihrer Obergrenze in Cent. Die Obergrenze entscheidet, ob
  eine Stufe zu den gewählten Leistungen überhaupt passen kann: Wer einen
  Blumenbogen und Tischgestaltung anfragt, kommt mit 1.000 € nicht hin, und
  eine Anfrage, die von vornherein nicht erfüllbar ist, kostet beide Seiten
  nur Zeit.

  Die Stufe „unter 1.000 €“ ist neu. Gala hatte ihre Staffel bei 1.000 €
  beginnen lassen — das passt für Veranstaltungen, aber nicht für den Fall,
  dass jemand nur den Brautstrauß möchte. Der kostet 120 €; ohne diese Stufe
  müsste man ein Budget angeben, das um ein Vielfaches darüber liegt.
*/
const budgets: { value: string; label: I18nText; obergrenze: number | null }[] = [
  {
    value: 'unter-1000',
    obergrenze: 100000,
    label: { de: 'bis 1.000 €', uk: 'до 1 000 €', en: 'up to €1,000', ru: 'до 1 000 €' },
  },
  {
    value: '1000-1500',
    obergrenze: 150000,
    label: { de: '1.000 – 1.500 €', uk: '1 000 – 1 500 €', en: '€1,000 – 1,500', ru: '1 000 – 1 500 €' },
  },
  {
    value: '1500-3000',
    obergrenze: 300000,
    label: { de: '1.500 – 3.000 €', uk: '1 500 – 3 000 €', en: '€1,500 – 3,000', ru: '1 500 – 3 000 €' },
  },
  {
    value: '3000-5000',
    obergrenze: 500000,
    label: { de: '3.000 – 5.000 €', uk: '3 000 – 5 000 €', en: '€3,000 – 5,000', ru: '3 000 – 5 000 €' },
  },
  {
    value: '5000-10000',
    obergrenze: 1000000,
    label: { de: '5.000 – 10.000 €', uk: '5 000 – 10 000 €', en: '€5,000 – 10,000', ru: '5 000 – 10 000 €' },
  },
  {
    // Ohne Obergrenze — bleibt immer wählbar.
    value: 'offen',
    obergrenze: null,
    label: { de: 'noch offen', uk: 'ще не визначено', en: 'not decided yet', ru: 'пока не решено' },
  },
];

/*
  Untergrenze je Leistung, in Cent. Abgeleitet ausschließlich aus dem, was Gala
  auf der Veranstaltungsseite selbst nennt: Brautstrauß 120 €, Anstecker ab
  25 € — zusammen 145 €. Für alles, was am Veranstaltungsort entsteht, gilt
  ihr zweiter Satz: eine vollständige florale Gestaltung beginnt bei 1.500 €,
  einschließlich Auf- und Abbau.

  ⚠️ TODO: Einzelpreise für Bogen, Tischgestaltung und Fotozone hat sie nicht
  genannt. Deshalb steht hier für alle drei derselbe Wert — er ist eine
  Untergrenze, keine Schätzung. Sobald Gala Einzelpreise nennt, gehören sie
  hierher.
*/
const LEISTUNG_MINDESTBUDGET: Record<string, number> = {
  brautstrauss: 14500,
  bogen: 150000,
  tische: 150000,
  fotozone: 150000,
  abbau: 150000,
};

const weddingServices: { value: string; label: I18nText }[] = [
  {
    value: 'brautstrauss',
    label: {
      de: 'Brautstrauß & Anstecker für den Bräutigam',
      uk: 'Букет нареченої та бутоньєрка для нареченого',
      en: 'Bridal bouquet & buttonhole for the groom',
      ru: 'Букет невесты и бутоньерки для жениха',
    },
  },
  {
    value: 'bogen',
    label: { de: 'Hochzeitsbogen', uk: 'Весільна арка', en: 'Wedding arch', ru: 'Свадебная арка' },
  },
  {
    value: 'tische',
    label: {
      de: 'Florale Tischgestaltung',
      uk: 'Флористичне оформлення столів',
      en: 'Floral table design',
      ru: 'Флористическое оформление столов',
    },
  },
  {
    value: 'fotozone',
    label: { de: 'Fotozone', uk: 'Фотозона', en: 'Photo backdrop', ru: 'Фотозона' },
  },
  {
    value: 'abbau',
    label: { de: 'Auf- und Abbau', uk: 'Монтаж і демонтаж', en: 'Set-up & take-down', ru: 'Монтаж и демонтаж' },
  },
];

/*
  Berlins zwölf Bezirke. Beim Workshop vor Ort entscheidet der Bezirk über die
  Zone und damit über die Anfahrt — deshalb fragt das Formular ihn ab, statt
  eine Adresse zu verlangen, die zum Zeitpunkt der Anfrage oft noch gar nicht
  feststeht. Die Postleitzahlen stehen dabei, weil viele ihre PLZ sicherer
  wissen als den amtlichen Bezirksnamen.
*/
const berlinDistricts: { value: string; label: string }[] = [
  { value: 'mitte', label: 'Mitte (10115 – 13359)' },
  { value: 'friedrichshain-kreuzberg', label: 'Friedrichshain-Kreuzberg (10243 – 10999)' },
  { value: 'pankow', label: 'Pankow (10405 – 13189)' },
  { value: 'charlottenburg-wilmersdorf', label: 'Charlottenburg-Wilmersdorf (10585 – 14199)' },
  { value: 'spandau', label: 'Spandau (13581 – 13629)' },
  { value: 'steglitz-zehlendorf', label: 'Steglitz-Zehlendorf (12157 – 14169)' },
  { value: 'tempelhof-schoeneberg', label: 'Tempelhof-Schöneberg (10777 – 12309)' },
  { value: 'neukoelln', label: 'Neukölln (12043 – 12359)' },
  { value: 'treptow-koepenick', label: 'Treptow-Köpenick (12435 – 12689)' },
  { value: 'marzahn-hellersdorf', label: 'Marzahn-Hellersdorf (12619 – 12689)' },
  { value: 'lichtenberg', label: 'Lichtenberg (10315 – 13059)' },
  { value: 'reinickendorf', label: 'Reinickendorf (13403 – 13629)' },
];
---

<form
  class="inq panel"
  data-inquiry
  data-topic={topic}
  data-busy-label={_('form.sending')}
  data-endpoint={asset('/api/inquiry')}
>
  <input type="hidden" name="topic" value={topic} />
  <input type="hidden" name="lang" value={lang} />
  {subject && <input type="hidden" name="subject" value={subject} />}

  <!-- Honeypot: für Menschen unsichtbar, Bots füllen es aus. -->
  <div class="hp" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <p class="hint inq-required">{_('form.required.note')}</p>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.firstname')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="text" name="firstName" required autocomplete="given-name" />
    </label>

    <label class="field">
      <span class="field-label">{_('form.lastname')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="text" name="lastName" required autocomplete="family-name" />
    </label>
  </div>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.email')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="email" name="email" required autocomplete="email" />
    </label>

    <label class="field">
      <span class="field-label">{_('form.phone')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="tel" name="phone" required autocomplete="tel" />
    </label>
  </div>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.date')} {showEventFields && <span class="req" aria-hidden="true">*</span>}</span>
      <input class="input" type="date" name="date" required={showEventFields} />
    </label>

    {
      showGuestFields && (
        <label class="field">
          <span class="field-label">{_('form.guests')}</span>
          <input class="input" type="number" name="guests" min="1" max="500" inputmode="numeric" />
        </label>
      )
    }
  </div>

  {
    showEventFields && (
      <div class="inq-row">
        <label class="field">
          <span class="field-label">{_('form.location')}</span>
          <input class="input" type="text" name="location" />
        </label>

        <label class="field">
          <span class="field-label">{_('form.budget')}</span>
          <select class="select" name="budget">
            {budgets.map((budget) => (
              <option value={budget.value} data-max={budget.obergrenze ?? ''}>
                {t(budget.label, lang)}
              </option>
            ))}
          </select>
        </label>
      </div>
    )
  }

  {
    topic === 'workshop' && (
      <label class="field">
        <span class="field-label">{_('form.district')}</span>
        <select class="select" name="district">
          <option value="">—</option>
          {berlinDistricts.map((district) => (
            <option value={district.value}>{district.label}</option>
          ))}
        </select>
      </label>
    )
  }

  {
    topic === 'wedding' && (
      <fieldset class="field">
        <legend class="field-label">{_('form.services')}</legend>
        <div class="choices choices--row">
          {weddingServices.map((service) => (
            <label class="choice choice--inline">
              <input
                type="checkbox"
                name="services"
                value={service.value}
                data-min={LEISTUNG_MINDESTBUDGET[service.value] ?? 0}
              />
              <span class="choice-title">{t(service.label, lang)}</span>
            </label>
          ))}
        </div>
        <p class="hint" data-budget-hint>{_('form.services.hint')}</p>
      </fieldset>
    )
  }

  <label class="field">
    <span class="field-label">{_('form.message')} <span class="req" aria-hidden="true">*</span></span>
    <textarea class="textarea" name="message" required placeholder={_('form.message.placeholder')}></textarea>
  </label>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span class="small">
      <Fragment set:html={_('form.privacy', {
        link: `<a href="${path(lang, 'datenschutz')}">${_('form.privacy.link')}</a>`,
      })} />
    </span>
  </label>

  <button class="btn btn--primary" type="submit" data-submit>{_('form.submit')}</button>

  <p class="inq-note inq-note--ok" hidden data-success>{_('form.success')}</p>
  <p class="inq-note inq-note--error" hidden data-error>
    {_('form.error')}<br />
    <a href={`mailto:${site.email}`}>{site.email}</a>
    {site.whatsapp && (
      <>
        {' · '}
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
          {_('channels.whatsapp')}
        </a>
      </>
    )}
  </p>

  <!--
    Selbst abschicken. Das Formular oben braucht einen Server; auf GitHub Pages
    gibt es den nicht, und selbst mit Server wollen viele lieber im Messenger
    schreiben, den sie ohnehin offen haben. Diese drei Wege tragen die
    ausgefüllten Angaben mit — niemand muss zweimal tippen, und Gala bekommt
    dieselben Felder wie per E-Mail.
  -->
  <div class="inq-direkt">
    <h3 class="field-label">{_('form.direct')}</h3>
    <p class="hint">{_('form.direct.hint')}</p>

    <div class="inq-direkt-row">
      {
        site.whatsapp && (
          <a class="btn btn--gold" data-direkt="whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
            {_('channels.whatsapp')}
          </a>
        )
      }
      <a class="btn btn--ghost" data-direkt="email" href={`mailto:${site.email}`}>{_('channels.email')}</a>
      <button class="btn btn--ghost" type="button" data-direkt="instagram" data-url={site.instagramUrl}>
        {_('channels.instagram')}
      </button>
    </div>

    <p class="inq-note inq-note--ok" hidden data-kopiert>{_('form.direct.copied')}</p>
  </div>
</form>

<style>
  /* Der Stern ist rein visuell — `required` sagt es assistiver Technik
     ohnehin, ein vorgelesenes „Stern“ wäre nur Lärm. Deshalb aria-hidden. */
  .req {
    color: var(--gold-lit);
  }

  .inq-required {
    margin-bottom: var(--space-5);
  }

  .inq-row {
    display: grid;
    gap: var(--space-4);
    /* px statt rem: In einem Grid ohne feste Breite kann `100%` nicht
       aufgelöst werden, dann gewinnt der rem-Wert — und der wächst mit der
       eingestellten Textgröße mit. */
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  }

  .inq fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-5);
    /* Fieldsets ignorieren sonst die Breite ihres Grid-Containers. */
    min-width: 0;
  }

  .inq .choice--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .inq fieldset legend {
    padding: 0;
    margin-bottom: var(--space-3);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: var(--space-5);
    cursor: pointer;
  }

  .consent input {
    margin-top: 0.25rem;
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    accent-color: var(--gold-lit);
  }

  .inq-note {
    margin: var(--space-4) 0 0;
    padding: 0.85rem 1.1rem;
    border-left: 2px solid var(--gold);
    background: rgb(144 112 64 / 0.12);
    font-size: 0.9rem;
  }

  .inq-direkt {
    border-top: 1px solid var(--line);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
  }

  .inq-direkt-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .inq-note--error {
    border-left-color: var(--mauve-deep);
    background: rgb(142 112 120 / 0.14);
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-inquiry]')) {
    const submitEl = form.querySelector<HTMLButtonElement>('[data-submit]');
    const successEl = form.querySelector<HTMLElement>('[data-success]');
    const errorEl = form.querySelector<HTMLElement>('[data-error]');

    /*
      Budget und Leistungen hängen zusammen. Wer einen Blumenbogen und
      Tischgestaltung anfragt, kommt mit 1.000 € nicht hin — eine Anfrage, die
      von vornherein nicht erfüllbar ist, kostet beide Seiten nur Zeit, und
      Gala müsste sie mit einer Absage beantworten.

      Gerechnet wird mit dem **Höchstwert** der gewählten Untergrenzen, nicht
      mit ihrer Summe: Was ein Bogen zusätzlich zur Tischgestaltung kostet,
      hat Gala nie gesagt, und es zu addieren wäre eine erfundene Zahl. Der
      Höchstwert ist die Aussage, die sich belegen lässt — mindestens so viel.
    */
    const budgetSelect = form.querySelector<HTMLSelectElement>('[name="budget"]');
    const serviceInputs = [...form.querySelectorAll<HTMLInputElement>('[name="services"]')];

    function budgetKoppeln(): void {
      if (!budgetSelect || !serviceInputs.length) return;

      const untergrenze = serviceInputs
        .filter((input) => input.checked)
        .reduce((hoechster, input) => Math.max(hoechster, Number(input.dataset.min ?? 0)), 0);

      let ersteGueltige: HTMLOptionElement | null = null;
      for (const option of budgetSelect.options) {
        const max = option.dataset.max ? Number(option.dataset.max) : null;
        // „noch offen“ hat keine Obergrenze und bleibt immer stehen.
        const passt = max === null || max > untergrenze;
        option.hidden = !passt;
        option.disabled = !passt;
        if (passt && !ersteGueltige) ersteGueltige = option;
      }

      if (budgetSelect.selectedOptions[0]?.disabled && ersteGueltige) {
        ersteGueltige.selected = true;
      }
    }

    // Am Formular statt an jedem Kästchen: So greift die Kopplung auch, wenn
    // die Auswahl anders zustande kommt als durch einen Klick — etwa nach
    // einem Reset oder wenn der Browser Felder wiederherstellt.
    form.addEventListener('change', budgetKoppeln);
    budgetKoppeln();

    /* ——— Anfrage selbst abschicken ——————————————————————————————————— */

    /**
     * Beschriftung eines Feldes, so wie sie auf der Seite steht — damit die
     * Nachricht in der Sprache der Seite entsteht und nicht in einer zweiten,
     * hier nochmal gepflegten Liste.
     */
    function beschriftung(feld: Element): string {
      const traeger = feld.closest('.field, fieldset');
      const text = traeger?.querySelector('.field-label')?.textContent ?? '';
      // Den Pflichtstern und Klammerzusätze abschneiden.
      return text.replace(/[*]/g, '').trim().replace(/\s+/g, ' ');
    }

    /**
     * Alles, was ausgefüllt ist — und nur das. Leere Felder wegzulassen ist
     * kein Informationsverlust: Eine Zeile „Anzahl Gäste:“ ohne Zahl sagt
     * weniger als gar keine Zeile.
     */
    function nachricht(): string {
      const zeilen: string[] = [];

      for (const feld of form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input:not([type="hidden"]):not([type="checkbox"]), select, textarea',
      )) {
        if (feld.name === 'website' || !feld.value.trim()) continue;
        const wert =
          feld instanceof HTMLSelectElement ? feld.selectedOptions[0]?.textContent?.trim() ?? feld.value : feld.value.trim();
        zeilen.push(`${beschriftung(feld)}: ${wert}`);
      }

      const leistungen = serviceInputs
        .filter((input) => input.checked)
        .map((input) => input.closest('.choice')?.querySelector('.choice-title')?.textContent?.trim() ?? input.value);
      if (leistungen.length) {
        const legende = form.querySelector('[name="services"]')?.closest('fieldset')?.querySelector('.field-label');
        zeilen.push(`${legende?.textContent?.trim() ?? 'Leistungen'}: ${leistungen.join(', ')}`);
      }

      const anlass = form.querySelector<HTMLInputElement>('[name="subject"]')?.value;
      if (anlass) zeilen.unshift(anlass);

      return zeilen.join('\n');
    }

    const kopiertEl = form.querySelector<HTMLElement>('[data-kopiert]');

    function direktAktualisieren(): void {
      const text = nachricht();

      const whatsapp = form.querySelector<HTMLAnchorElement>('[data-direkt="whatsapp"]');
      if (whatsapp) {
        whatsapp.href = `${whatsapp.href.split('?')[0]}?text=${encodeURIComponent(text)}`;
      }

      const mail = form.querySelector<HTMLAnchorElement>('[data-direkt="email"]');
      if (mail) {
        // Kein URLSearchParams: Das kodiert Leerzeichen als „+“, und in einer
        // mailto-Adresse bleibt daraus ein Pluszeichen im Text.
        const betreff = form.querySelector<HTMLInputElement>('[name="subject"]')?.value || document.title;
        mail.href =
          `${mail.href.split('?')[0]}?subject=${encodeURIComponent(betreff)}&body=${encodeURIComponent(text)}`;
      }
    }

    /*
      Instagram kennt keinen Weg, eine Direktnachricht vorauszufüllen — es gibt
      schlicht kein Adressschema dafür. Deshalb wandert der Text in die
      Zwischenablage und das Profil geht auf; einfügen muss man selbst. Das ist
      ehrlicher, als einen Knopf anzubieten, der ein leeres Fenster öffnet.
    */
    form.querySelector<HTMLButtonElement>('[data-direkt="instagram"]')?.addEventListener('click', async (event) => {
      const knopf = event.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(nachricht());
        if (kopiertEl) kopiertEl.hidden = false;
      } catch {
        // Ohne Zwischenablage-Recht (älterer Browser, kein HTTPS) bleibt der
        // Hinweis aus — das Profil geht trotzdem auf.
      }
      window.open(knopf.dataset.url, '_blank', 'noopener');
    });

    form.addEventListener('input', direktAktualisieren);
    form.addEventListener('change', direktAktualisieren);
    direktAktualisieren();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const label = submitEl?.textContent ?? '';
      if (submitEl) {
        submitEl.disabled = true;
        submitEl.textContent = form.dataset.busyLabel ?? label;
      }
      if (errorEl) errorEl.hidden = true;

      const payload = Object.fromEntries(new FormData(form).entries());
      // Mehrfachauswahl geht bei Object.fromEntries verloren — separat nachtragen.
      const services = new FormData(form).getAll('services').map(String);

      try {
        const response = await fetch(form.dataset.endpoint ?? '/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, services }),
        });
        if (!response.ok) throw new Error(`inquiry failed: ${response.status}`);

        form.reset();
        if (successEl) successEl.hidden = false;
        if (submitEl) submitEl.hidden = true;
        successEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        console.error(error);
        if (errorEl) errorEl.hidden = false;
        if (submitEl) {
          submitEl.disabled = false;
          submitEl.textContent = label;
        }
      }
    });
  }
</script>
