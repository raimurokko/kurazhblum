---
import { asset, path, t, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';
import type { I18nText } from '../i18n/config';

type Topic = 'wedding' | 'event' | 'workshop' | 'general';

interface Props {
  lang: Locale;
  topic: Topic;
  /** Vorbelegung, z. B. der gewählte Workshop. */
  subject?: string;
}

const { lang, topic, subject = '' } = Astro.props;
const _ = useTranslations(lang);

/** Nur für Hochzeiten und Events relevant. */
const showEventFields = topic === 'wedding' || topic === 'event';
const showGuestFields = showEventFields || topic === 'workshop';

/*
  Budgetstufen mit ihrer Obergrenze in Cent. Die Obergrenze entscheidet, ob
  eine Stufe zu den gewählten Leistungen überhaupt passen kann: Wer einen
  Blumenbogen und Tischgestaltung anfragt, kommt mit 1.000 € nicht hin, und
  eine Anfrage, die von vornherein nicht erfüllbar ist, kostet beide Seiten
  nur Zeit.

  Die Stufe „unter 1.000 €“ ist neu. Gala hatte ihre Staffel bei 1.000 €
  beginnen lassen — das passt für Veranstaltungen, aber nicht für den Fall,
  dass jemand nur den Brautstrauß möchte. Der kostet 120 €; ohne diese Stufe
  müsste man ein Budget angeben, das um ein Vielfaches darüber liegt.
*/
const budgets: { value: string; label: I18nText; obergrenze: number | null }[] = [
  {
    value: 'unter-1000',
    obergrenze: 100000,
    label: { de: 'bis 1.000 €', uk: 'до 1 000 €', en: 'up to €1,000', ru: 'до 1 000 €' },
  },
  {
    value: '1000-1500',
    obergrenze: 150000,
    label: { de: '1.000 – 1.500 €', uk: '1 000 – 1 500 €', en: '€1,000 – 1,500', ru: '1 000 – 1 500 €' },
  },
  {
    value: '1500-3000',
    obergrenze: 300000,
    label: { de: '1.500 – 3.000 €', uk: '1 500 – 3 000 €', en: '€1,500 – 3,000', ru: '1 500 – 3 000 €' },
  },
  {
    value: '3000-5000',
    obergrenze: 500000,
    label: { de: '3.000 – 5.000 €', uk: '3 000 – 5 000 €', en: '€3,000 – 5,000', ru: '3 000 – 5 000 €' },
  },
  {
    value: '5000-10000',
    obergrenze: 1000000,
    label: { de: '5.000 – 10.000 €', uk: '5 000 – 10 000 €', en: '€5,000 – 10,000', ru: '5 000 – 10 000 €' },
  },
  {
    // Ohne Obergrenze — bleibt immer wählbar.
    value: 'offen',
    obergrenze: null,
    label: { de: 'noch offen', uk: 'ще не визначено', en: 'not decided yet', ru: 'пока не решено' },
  },
];

/*
  Untergrenze je Leistung, in Cent. Abgeleitet ausschließlich aus dem, was Gala
  auf der Veranstaltungsseite selbst nennt: Brautstrauß 120 €, Anstecker ab
  25 € — zusammen 145 €. Für alles, was am Veranstaltungsort entsteht, gilt
  ihr zweiter Satz: eine vollständige florale Gestaltung beginnt bei 1.500 €,
  einschließlich Auf- und Abbau.

  ⚠️ TODO: Einzelpreise für Bogen, Tischgestaltung und Fotozone hat sie nicht
  genannt. Deshalb steht hier für alle drei derselbe Wert — er ist eine
  Untergrenze, keine Schätzung. Sobald Gala Einzelpreise nennt, gehören sie
  hierher.
*/
const LEISTUNG_MINDESTBUDGET: Record<string, number> = {
  brautstrauss: 14500,
  bogen: 150000,
  tische: 150000,
  fotozone: 150000,
  abbau: 150000,
};

const weddingServices: { value: string; label: I18nText }[] = [
  {
    value: 'brautstrauss',
    label: {
      de: 'Brautstrauß & Anstecker für den Bräutigam',
      uk: 'Букет нареченої та бутоньєрка для нареченого',
      en: 'Bridal bouquet & buttonhole for the groom',
      ru: 'Букет невесты и бутоньерки для жениха',
    },
  },
  {
    value: 'bogen',
    label: { de: 'Hochzeitsbogen', uk: 'Весільна арка', en: 'Wedding arch', ru: 'Свадебная арка' },
  },
  {
    value: 'tische',
    label: {
      de: 'Florale Tischgestaltung',
      uk: 'Флористичне оформлення столів',
      en: 'Floral table design',
      ru: 'Флористическое оформление столов',
    },
  },
  {
    value: 'fotozone',
    label: { de: 'Fotozone', uk: 'Фотозона', en: 'Photo backdrop', ru: 'Фотозона' },
  },
  {
    value: 'abbau',
    label: { de: 'Auf- und Abbau', uk: 'Монтаж і демонтаж', en: 'Set-up & take-down', ru: 'Монтаж и демонтаж' },
  },
];

/*
  Berlins zwölf Bezirke. Beim Workshop vor Ort entscheidet der Bezirk über die
  Zone und damit über die Anfahrt — deshalb fragt das Formular ihn ab, statt
  eine Adresse zu verlangen, die zum Zeitpunkt der Anfrage oft noch gar nicht
  feststeht. Die Postleitzahlen stehen dabei, weil viele ihre PLZ sicherer
  wissen als den amtlichen Bezirksnamen.
*/
const berlinDistricts: { value: string; label: string }[] = [
  { value: 'mitte', label: 'Mitte (10115 – 13359)' },
  { value: 'friedrichshain-kreuzberg', label: 'Friedrichshain-Kreuzberg (10243 – 10999)' },
  { value: 'pankow', label: 'Pankow (10405 – 13189)' },
  { value: 'charlottenburg-wilmersdorf', label: 'Charlottenburg-Wilmersdorf (10585 – 14199)' },
  { value: 'spandau', label: 'Spandau (13581 – 13629)' },
  { value: 'steglitz-zehlendorf', label: 'Steglitz-Zehlendorf (12157 – 14169)' },
  { value: 'tempelhof-schoeneberg', label: 'Tempelhof-Schöneberg (10777 – 12309)' },
  { value: 'neukoelln', label: 'Neukölln (12043 – 12359)' },
  { value: 'treptow-koepenick', label: 'Treptow-Köpenick (12435 – 12689)' },
  { value: 'marzahn-hellersdorf', label: 'Marzahn-Hellersdorf (12619 – 12689)' },
  { value: 'lichtenberg', label: 'Lichtenberg (10315 – 13059)' },
  { value: 'reinickendorf', label: 'Reinickendorf (13403 – 13629)' },
];
---

<form
  class="inq panel"
  data-inquiry
  data-topic={topic}
>
  <input type="hidden" name="topic" value={topic} />
  <input type="hidden" name="lang" value={lang} />
  {subject && <input type="hidden" name="subject" value={subject} />}

  <!-- Honeypot: für Menschen unsichtbar, Bots füllen es aus. -->
  <div class="hp" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <p class="hint inq-required">{_('form.required.note')}</p>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.firstname')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="text" name="firstName" required autocomplete="given-name" />
    </label>

    <label class="field">
      <span class="field-label">{_('form.lastname')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="text" name="lastName" required autocomplete="family-name" />
    </label>
  </div>

  <div class="inq-row">
    <label class="field">
      <span class="field-label">{_('form.email')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="email" name="email" required autocomplete="email" />
    </label>

    <label class="field">
      <span class="field-label">{_('form.phone')} <span class="req" aria-hidden="true">*</span></span>
      <input class="input" type="tel" name="phone" required autocomplete="tel" />
    </label>
  </div>

  <div class="inq-row">
    {
      /*
        Der Termin der Kundin — Hochzeit, Veranstaltung, Wunschtermin für den
        Kurs. Bleibt frei wählbar: Eine Hochzeit findet nicht heute statt.
        Bei einer allgemeinen Anfrage gibt es keinen solchen Termin, dort
        entfällt das Feld.
      */
      topic !== 'general' && (
        <label class="field">
          <span class="field-label">{_('form.date')} {showEventFields && <span class="req" aria-hidden="true">*</span>}</span>
          <input class="input" type="date" name="date" required={showEventFields} />
        </label>
      )
    }

    {/*
      Zeitstempel der Anfrage. Sichtbar, aber nicht änderbar — er soll sagen,
      wann geschrieben wurde, und das ist keine Angabe, die zur Auswahl steht.
      Gefüllt wird er im Browser: Ein serverseitig gesetztes Datum wäre der
      Build-Zeitpunkt und stünde in wenigen Tagen falsch da.
    */}
    <label class="field">
      <span class="field-label">{_('form.sent')}</span>
      <input class="input input--fest" type="text" name="sent" readonly data-zeitstempel />
      <span class="hint">{_('form.sent.hint')}</span>
    </label>

    {
      showGuestFields && (
        <label class="field">
          <span class="field-label">{_('form.guests')}</span>
          <input class="input" type="number" name="guests" min="1" max="500" inputmode="numeric" />
        </label>
      )
    }
  </div>

  {
    showEventFields && (
      <div class="inq-row">
        {/*
          Adresse mit Vorschlägen aus einer lokal liegenden Liste Berliner
          Straßen. `datalist` schlägt vor, ohne die Eingabe einzuschränken —
          wichtig, weil viele den Namen der Location tippen („Alte Börse“) und
          nicht die Straße. Die Liste wird erst beim ersten Klick ins Feld
          nachgeladen, siehe Skript unten.
        */}
        <label class="field">
          <span class="field-label">{_('form.location')}</span>
          <input
            class="input"
            type="text"
            name="location"
            list="orte-berlin"
            autocomplete="off"
            data-orte={asset('/data/berlin-strassen.json')}
          />
          <datalist id="orte-berlin" />
          <span class="hint">{_('form.location.hint')}</span>
        </label>

        <label class="field">
          <span class="field-label">{_('form.budget')}</span>
          <select class="select" name="budget">
            {budgets.map((budget) => (
              <option value={budget.value} data-max={budget.obergrenze ?? ''}>
                {t(budget.label, lang)}
              </option>
            ))}
          </select>
        </label>
      </div>
    )
  }

  {
    topic === 'workshop' && (
      <label class="field">
        <span class="field-label">{_('form.district')}</span>
        <select class="select" name="district">
          <option value="">—</option>
          {berlinDistricts.map((district) => (
            <option value={district.value}>{district.label}</option>
          ))}
        </select>
      </label>
    )
  }

  {
    topic === 'wedding' && (
      <fieldset class="field">
        <legend class="field-label">{_('form.services')}</legend>
        <div class="choices choices--row">
          {weddingServices.map((service) => (
            <label class="choice choice--inline">
              <input
                type="checkbox"
                name="services"
                value={service.value}
                data-min={LEISTUNG_MINDESTBUDGET[service.value] ?? 0}
              />
              <span class="choice-title">{t(service.label, lang)}</span>
            </label>
          ))}
        </div>
        <p class="hint" data-budget-hint>{_('form.services.hint')}</p>
      </fieldset>
    )
  }

  <label class="field">
    <span class="field-label">{_('form.message')} <span class="req" aria-hidden="true">*</span></span>
    <textarea class="textarea" name="message" required placeholder={_('form.message.placeholder')}></textarea>
  </label>

  <label class="consent">
    <input type="checkbox" name="consent" required />
    <span class="small">
      <Fragment set:html={_('form.privacy', {
        link: `<a href="${path(lang, 'datenschutz')}">${_('form.privacy.link')}</a>`,
      })} />
    </span>
  </label>

  <!--
    Zweiter Haken, getrennt vom ersten. Die Angaben verlassen hier nicht den
    eigenen Server — sie gehen über WhatsApp, Instagram oder das Mailprogramm
    der Absenderin, also über Dritte und je nach Anbieter in die USA. Das ist
    eine andere Aussage als „Datenschutzerklärung gelesen“, und zwei getrennte
    Aussagen brauchen zwei Haken; gebündelte Einwilligung ist keine.
  -->
  <label class="consent">
    <input type="checkbox" name="consentThirdParty" data-drittland />
    <span class="small">
      <Fragment set:html={_('form.thirdparty', {
        link: `<a href="${path(lang, 'datenschutz')}">${_('form.privacy.link')}</a>`,
      })} />
    </span>
  </label>

  <!--
    Die einzige Art, die Anfrage abzuschicken. Der frühere Knopf „Anfrage
    senden“ ging über einen eigenen Server; er tat dasselbe wie diese drei
    Wege, brauchte aber einen Mailversand, den es noch nicht gibt, und stand
    doppelt da. Hier gehen die ausgefüllten Angaben mit — niemand tippt
    zweimal, und Gala bekommt dieselben Felder.
  -->
  <div class="inq-direkt">
    <p class="hint">{_('form.direct.hint')}</p>
    <p class="inq-note" data-gesperrt>{_('form.direct.locked')}</p>

    <div class="inq-direkt-row">
      {
        site.whatsapp && (
          <a class="btn btn--gold" data-direkt="whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
            {_('channels.whatsapp')}
          </a>
        )
      }
      <a class="btn btn--ghost" data-direkt="email" href={`mailto:${site.email}`}>{_('channels.email')}</a>
      <button class="btn btn--ghost" type="button" data-direkt="instagram" data-url={site.instagramDirectUrl}>
        {_('channels.instagram')}
      </button>
    </div>

    <p class="inq-note inq-note--ok" hidden data-kopiert>{_('form.direct.copied')}</p>
  </div>

  <!--
    Instagram kann eine Direktnachricht nicht vorausfüllen — es gibt kein
    Adressschema dafür. Der Text geht deshalb in die Zwischenablage, und dieser
    Dialog sagt, was damit zu tun ist, bevor der Chat aufgeht. Erst nach dem
    Bestätigen wird das Fenster geöffnet: So ist der Klick auf „Weiter“ die
    Geste, die den Popup-Blocker passieren lässt.

    <dialog> statt confirm(): Es bringt Fokusfalle, Esc und Vorlesbarkeit von
    sich aus mit, und es lässt sich wie der Rest der Seite gestalten.
  -->
  <dialog class="einfuegen" data-einfuegen data-strg={_('form.direct.shortcut')}>
    <h3 class="einfuegen-titel">{_('form.direct.paste.title')}</h3>
    <div data-einfuegen-gelungen>
      <p class="muted">
        <Fragment set:html={_('form.direct.paste.text', { shortcut: '<kbd data-kuerzel></kbd>' })} />
      </p>
      <p class="hint">{_('form.direct.paste.mobile')}</p>
    </div>

    {/*
      Rückfall, wenn die Zwischenablage nicht darf — älterer Browser oder
      Seite ohne HTTPS. Dann steht der Text zum Selbstmarkieren da, statt dass
      der Dialog eine Kopie behauptet, die es nicht gibt.
    */}
    <div hidden data-einfuegen-manuell>
      <p class="muted">{_('form.direct.paste.manual')}</p>
      <textarea class="textarea" rows="6" readonly data-einfuegen-text></textarea>
    </div>

    <div class="einfuegen-row">
      <button class="btn btn--primary" type="button" data-einfuegen-ok>{_('form.direct.paste.ok')}</button>
      <button class="btn btn--ghost" type="button" data-einfuegen-ab>{_('form.direct.paste.cancel')}</button>
    </div>
  </dialog>
</form>

<style>
  /* Der Stern ist rein visuell — `required` sagt es assistiver Technik
     ohnehin, ein vorgelesenes „Stern“ wäre nur Lärm. Deshalb aria-hidden. */
  .req {
    color: var(--gold-lit);
  }

  .inq-required {
    margin-bottom: var(--space-5);
  }

  .inq-row {
    display: grid;
    gap: var(--space-4);
    /* px statt rem: In einem Grid ohne feste Breite kann `100%` nicht
       aufgelöst werden, dann gewinnt der rem-Wert — und der wächst mit der
       eingestellten Textgröße mit. */
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  }

  .inq fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-5);
    /* Fieldsets ignorieren sonst die Breite ihres Grid-Containers. */
    min-width: 0;
  }

  .inq .choice--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .inq fieldset legend {
    padding: 0;
    margin-bottom: var(--space-3);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: var(--space-5);
    cursor: pointer;
  }

  .consent input {
    margin-top: 0.25rem;
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    accent-color: var(--gold-lit);
  }

  .inq-note {
    margin: var(--space-4) 0 0;
    padding: 0.85rem 1.1rem;
    border-left: 2px solid var(--gold);
    background: rgb(144 112 64 / 0.12);
    font-size: 0.9rem;
  }

  /* Der Dialog erbt nichts vom Formular — er hängt im Top-Layer. Deshalb
     stehen Hintergrund und Rahmen hier noch einmal ausdrücklich. */
  .einfuegen {
    max-width: min(30rem, 88vw);
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
    color: var(--cream-2);
  }

  .einfuegen::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .einfuegen-titel {
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
    color: var(--cream);
  }

  .einfuegen kbd {
    font-family: var(--font-body), monospace;
    font-size: 0.9em;
    padding: 0.15em 0.45em;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--ink-3);
    color: var(--cream);
    white-space: nowrap;
  }

  .einfuegen-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  /* Gesperrt statt versteckt: Wer die Knöpfe sieht, versteht, wofür die
     Haken sind. Kein `display:none` — die Zeile darüber sagt, was fehlt. */
  /* Nicht änderbar, und das soll man sehen: gedämpft, ohne Textcursor.
     Fokussierbar bleibt es, damit Screenreader den Wert vorlesen. */
  .input--fest {
    color: var(--cream-3);
    cursor: default;
  }

  .btn--aus {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .inq-direkt {
    border-top: 1px solid var(--line);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
  }

  .inq-direkt-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .inq-note--error {
    border-left-color: var(--mauve-deep);
    background: rgb(142 112 120 / 0.14);
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-inquiry]')) {

    /*
      Budget und Leistungen hängen zusammen. Wer einen Blumenbogen und
      Tischgestaltung anfragt, kommt mit 1.000 € nicht hin — eine Anfrage, die
      von vornherein nicht erfüllbar ist, kostet beide Seiten nur Zeit, und
      Gala müsste sie mit einer Absage beantworten.

      Gerechnet wird mit dem **Höchstwert** der gewählten Untergrenzen, nicht
      mit ihrer Summe: Was ein Bogen zusätzlich zur Tischgestaltung kostet,
      hat Gala nie gesagt, und es zu addieren wäre eine erfundene Zahl. Der
      Höchstwert ist die Aussage, die sich belegen lässt — mindestens so viel.

      Am 13.08.2026 als gewollt bestätigt. Nicht zur Summe umbauen, auch wenn
      Gala später Einzelpreise nennt: Dann gehören die echten Beträge nach
      LEISTUNG_MINDESTBUDGET, und die Rechenart bleibt, wie sie ist.
    */
    const budgetSelect = form.querySelector<HTMLSelectElement>('[name="budget"]');
    const serviceInputs = [...form.querySelectorAll<HTMLInputElement>('[name="services"]')];

    function budgetKoppeln(): void {
      if (!budgetSelect || !serviceInputs.length) return;

      const untergrenze = serviceInputs
        .filter((input) => input.checked)
        .reduce((hoechster, input) => Math.max(hoechster, Number(input.dataset.min ?? 0)), 0);

      let ersteGueltige: HTMLOptionElement | null = null;
      for (const option of budgetSelect.options) {
        const max = option.dataset.max ? Number(option.dataset.max) : null;
        // „noch offen“ hat keine Obergrenze und bleibt immer stehen.
        const passt = max === null || max > untergrenze;
        option.hidden = !passt;
        option.disabled = !passt;
        if (passt && !ersteGueltige) ersteGueltige = option;
      }

      if (budgetSelect.selectedOptions[0]?.disabled && ersteGueltige) {
        ersteGueltige.selected = true;
      }
    }

    // Am Formular statt an jedem Kästchen: So greift die Kopplung auch, wenn
    // die Auswahl anders zustande kommt als durch einen Klick — etwa nach
    // einem Reset oder wenn der Browser Felder wiederherstellt.
    form.addEventListener('change', budgetKoppeln);
    budgetKoppeln();

    /* ——— Adressvorschläge ————————————————————————————————————————————— */

    /*
      Rund 9.000 Berliner Straßennamen, lokal. Kein Geocoder-Aufruf: Der würde
      bei jedem Tastendruck IP-Adresse und Eingabe an einen Dritten schicken,
      und ausgerechnet eine Veranstaltungsadresse verrät mehr als das übliche
      Surfen. Die Liste kommt vom eigenen Server, gefiltert wird im Browser.

      Erst beim ersten Klick ins Feld geladen — 168 KB gehören nicht in den
      Seitenaufbau, wenn die meisten Anfragen den Ort gar nicht ausfüllen.

      Nicht alle 9.000 in die datalist: Das wäre ein Baum aus 9.000 Knoten für
      jede Tastatureingabe. Zwanzig Treffer reichen, mehr zeigt kein Browser
      sinnvoll an.
    */
    const ortFeld = form.querySelector<HTMLInputElement>('[name="location"][data-orte]');
    const ortListe = form.querySelector<HTMLDataListElement>('#orte-berlin');

    if (ortFeld && ortListe) {
      let strassen: string[] | null = null;
      let laden: Promise<void> | null = null;

      function strassenLaden(): Promise<void> {
        if (!laden) {
          laden = fetch(ortFeld!.dataset.orte ?? '')
            .then((antwort) => (antwort.ok ? antwort.json() : []))
            .then((daten) => {
              strassen = Array.isArray(daten) ? daten : [];
            })
            .catch(() => {
              // Ohne Liste bleibt das Feld ein normales Textfeld. Kein Grund,
              // die Anfrage daran scheitern zu lassen.
              strassen = [];
            });
        }
        return laden;
      }

      function vorschlagen(): void {
        const eingabe = ortFeld!.value.trim().toLowerCase();
        if (!strassen || eingabe.length < 2) {
          ortListe!.replaceChildren();
          return;
        }

        // Erst was vorne passt, dann was irgendwo passt — „Haupt“ soll
        // Hauptstraße zeigen, nicht Bahnhofshauptweg.
        const beginnt: string[] = [];
        const enthaelt: string[] = [];
        for (const strasse of strassen) {
          const klein = strasse.toLowerCase();
          if (klein.startsWith(eingabe)) beginnt.push(strasse);
          else if (klein.includes(eingabe)) enthaelt.push(strasse);
          if (beginnt.length >= 20) break;
        }

        ortListe!.replaceChildren(
          ...[...beginnt, ...enthaelt].slice(0, 20).map((strasse) => {
            const option = document.createElement('option');
            option.value = strasse;
            return option;
          }),
        );
      }

      ortFeld.addEventListener('focus', () => void strassenLaden().then(vorschlagen), { once: true });
      ortFeld.addEventListener('input', () => void strassenLaden().then(vorschlagen));
    }

    /* ——— Zeitstempel ————————————————————————————————————————————————— */

    const INTL_LOCALE: Record<string, string> = {
      de: 'de-DE',
      uk: 'uk-UA',
      en: 'en-IE',
      ru: 'ru-RU',
    };
    const seitenSprache = form.querySelector<HTMLInputElement>('[name="lang"]')?.value ?? 'de';
    const ortsformat = INTL_LOCALE[seitenSprache] ?? 'de-DE';
    const stempelFeld = form.querySelector<HTMLInputElement>('[data-zeitstempel]');

    /** Nur das Datum — das steht sichtbar im Feld. */
    function heute(): string {
      return new Date().toLocaleDateString(ortsformat, {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      });
    }

    /**
     * Datum **und** Uhrzeit. Kommt erst in die Nachricht, und zwar in dem
     * Moment, in dem sie gebaut wird — nicht beim Seitenaufbau. Wer das
     * Formular halb ausfüllt, Kaffee holt und dann sendet, hätte sonst eine
     * Uhrzeit von vor einer halben Stunde im Text.
     */
    function jetzt(): string {
      const d = new Date();
      return `${d.toLocaleDateString(ortsformat, { day: '2-digit', month: '2-digit', year: 'numeric' })}, ${d.toLocaleTimeString(ortsformat, { hour: '2-digit', minute: '2-digit' })}`;
    }

    if (stempelFeld) stempelFeld.value = heute();

    /* ——— Anfrage selbst abschicken ——————————————————————————————————— */

    /**
     * Beschriftung eines Feldes, so wie sie auf der Seite steht — damit die
     * Nachricht in der Sprache der Seite entsteht und nicht in einer zweiten,
     * hier nochmal gepflegten Liste.
     */
    function beschriftung(feld: Element): string {
      const traeger = feld.closest('.field, fieldset');
      const text = traeger?.querySelector('.field-label')?.textContent ?? '';
      // Den Pflichtstern und Klammerzusätze abschneiden.
      return text.replace(/[*]/g, '').trim().replace(/\s+/g, ' ');
    }

    /**
     * Alles, was ausgefüllt ist — und nur das. Leere Felder wegzulassen ist
     * kein Informationsverlust: Eine Zeile „Anzahl Gäste:“ ohne Zahl sagt
     * weniger als gar keine Zeile.
     */
    function nachricht(): string {
      const zeilen: string[] = [];

      for (const feld of form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input:not([type="hidden"]):not([type="checkbox"]), select, textarea',
      )) {
        if (feld.name === 'website' || !feld.value.trim()) continue;
        // Der Zeitstempel bekommt hier die Uhrzeit dazu — im Feld steht sie
        // nicht, weil sie dort mit jeder Minute veralten würde.
        const wert =
          feld === stempelFeld
            ? jetzt()
            : feld instanceof HTMLSelectElement
            ? feld.selectedOptions[0]?.textContent?.trim() ?? feld.value
            : feld.value.trim();
        zeilen.push(`${beschriftung(feld)}: ${wert}`);
      }

      const leistungen = serviceInputs
        .filter((input) => input.checked)
        .map((input) => input.closest('.choice')?.querySelector('.choice-title')?.textContent?.trim() ?? input.value);
      if (leistungen.length) {
        const legende = form.querySelector('[name="services"]')?.closest('fieldset')?.querySelector('.field-label');
        zeilen.push(`${legende?.textContent?.trim() ?? 'Leistungen'}: ${leistungen.join(', ')}`);
      }

      const anlass = form.querySelector<HTMLInputElement>('[name="subject"]')?.value;
      if (anlass) zeilen.unshift(anlass);

      return zeilen.join('\n');
    }

    const kopiertEl = form.querySelector<HTMLElement>('[data-kopiert]');

    function direktAktualisieren(): void {
      const text = nachricht();

      const whatsapp = form.querySelector<HTMLAnchorElement>('[data-direkt="whatsapp"]');
      if (whatsapp) {
        whatsapp.href = `${whatsapp.href.split('?')[0]}?text=${encodeURIComponent(text)}`;
      }

      const mail = form.querySelector<HTMLAnchorElement>('[data-direkt="email"]');
      if (mail) {
        // Kein URLSearchParams: Das kodiert Leerzeichen als „+“, und in einer
        // mailto-Adresse bleibt daraus ein Pluszeichen im Text.
        const betreff = form.querySelector<HTMLInputElement>('[name="subject"]')?.value || document.title;
        mail.href =
          `${mail.href.split('?')[0]}?subject=${encodeURIComponent(betreff)}&body=${encodeURIComponent(text)}`;
      }
    }

    /*
      Instagram kennt keinen Weg, eine Direktnachricht vorauszufüllen — es gibt
      schlicht kein Adressschema dafür. Deshalb wandert der Text in die
      Zwischenablage und das Profil geht auf; einfügen muss man selbst. Das ist
      ehrlicher, als einen Knopf anzubieten, der ein leeres Fenster öffnet.
    */
    const dialog = form.querySelector<HTMLDialogElement>('[data-einfuegen]');

    /*
      ⌘ auf Apple-Geräten, Strg überall sonst. `userAgentData.platform` ist der
      aktuelle Weg, `platform` der Rückfall für ältere Browser — beide können
      fehlen, dann entscheidet der User-Agent-Text.
    */
    const plattform =
      (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ??
      navigator.platform ??
      navigator.userAgent;
    const istApple = /mac|iphone|ipad|ipod/i.test(plattform);

    for (const kbd of form.querySelectorAll<HTMLElement>('[data-kuerzel]')) {
      kbd.textContent = istApple ? '⌘ + V' : (dialog?.dataset.strg ?? 'Ctrl + V');
    }

    function instagramOeffnen(url: string): void {
      window.open(url, '_blank', 'noopener');
    }

    form.querySelector<HTMLButtonElement>('[data-direkt="instagram"]')?.addEventListener('click', async (event) => {
      const knopf = event.currentTarget as HTMLButtonElement;
      const url = knopf.dataset.url ?? '';
      const text = nachricht();

      // Ohne Eingaben gibt es nichts einzufügen — dann direkt in den Chat,
      // statt einen Dialog über eine leere Zwischenablage zu zeigen.
      if (!text.trim()) {
        instagramOeffnen(url);
        return;
      }

      let kopiert = false;
      try {
        await navigator.clipboard.writeText(text);
        kopiert = true;
      } catch {
        // Kein Zwischenablage-Recht (älterer Browser, kein HTTPS).
      }

      // Ohne Dialog (sehr alter Browser) bleibt nur der direkte Weg.
      if (!dialog) {
        instagramOeffnen(url);
        return;
      }

      // Der Dialog kommt in beiden Fällen — bestätigt wird immer, nur der
      // Inhalt unterscheidet sich: kopiert oder zum Selbstkopieren.
      const gelungen = dialog.querySelector<HTMLElement>('[data-einfuegen-gelungen]');
      const manuell = dialog.querySelector<HTMLElement>('[data-einfuegen-manuell]');
      const feld = dialog.querySelector<HTMLTextAreaElement>('[data-einfuegen-text]');

      if (gelungen) gelungen.hidden = !kopiert;
      if (manuell) manuell.hidden = kopiert;
      if (feld && !kopiert) feld.value = text;
      if (kopiertEl) kopiertEl.hidden = !kopiert;

      dialog.dataset.ziel = url;
      dialog.showModal();
      if (feld && !kopiert) feld.select();
    });

    dialog?.querySelector<HTMLButtonElement>('[data-einfuegen-ok]')?.addEventListener('click', () => {
      const url = dialog.dataset.ziel ?? '';
      dialog.close();
      instagramOeffnen(url);
    });

    dialog?.querySelector<HTMLButtonElement>('[data-einfuegen-ab]')?.addEventListener('click', () => dialog.close());

    form.addEventListener('input', direktAktualisieren);
    form.addEventListener('change', direktAktualisieren);
    direktAktualisieren();

    /*
      Freigabe der drei Wege. Zwei Haken, zwei Aussagen: Der erste bestätigt,
      dass die Datenschutzerklärung gelesen wurde, der zweite die Weitergabe
      an Dritte samt Übermittlung in die USA. Beides in einen Haken zu packen
      wäre gebündelte Einwilligung — und damit keine.

      Geprüft wird zusätzlich, ob die Pflichtfelder gefüllt sind: Eine
      Nachricht ohne Namen und Telefon nützt Gala nichts, und ein Messenger
      kennt kein `required`.
    */
    const zustimmung = form.querySelector<HTMLInputElement>('[name="consent"]');
    const drittland = form.querySelector<HTMLInputElement>('[data-drittland]');
    const wege = [...form.querySelectorAll<HTMLElement>('[data-direkt]')];
    const sperreEl = form.querySelector<HTMLElement>('[data-gesperrt]');

    function freigeben(): void {
      const haken = Boolean(zustimmung?.checked) && Boolean(drittland?.checked);
      const felder = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')]
        .filter((feld) => feld.type !== 'checkbox')
        .every((feld) => feld.value.trim().length > 0);
      const frei = haken && felder;

      for (const weg of wege) {
        weg.classList.toggle('btn--aus', !frei);
        weg.setAttribute('aria-disabled', frei ? 'false' : 'true');
        if (weg instanceof HTMLButtonElement) weg.disabled = !frei;
      }
      if (sperreEl) sperreEl.hidden = frei;
    }

    // Links lassen sich nicht `disabled` setzen — der Klick muss abgefangen
    // werden, sonst öffnet WhatsApp trotz fehlender Einwilligung.
    for (const weg of wege) {
      weg.addEventListener(
        'click',
        (event) => {
          if (weg.getAttribute('aria-disabled') === 'true') {
            event.preventDefault();
            event.stopImmediatePropagation();
            sperreEl?.scrollIntoView({ block: 'nearest' });
            return;
          }
          // Uhrzeit auf den Klick selbst setzen. WhatsApp und E-Mail sind
          // Links — ihre Adresse steht schon fest, wenn der Klick kommt, und
          // trüge sonst die Minute des letzten Tastendrucks.
          direktAktualisieren();
        },
        true,
      );
    }

    form.addEventListener('input', freigeben);
    form.addEventListener('change', freigeben);
    freigeben();
  }
</script>
