---
/**
 * Stumme Videoschleife mit Posterbild.
 *
 * Warum selbst gehostet und nicht eingebettet: Ein YouTube- oder Vimeo-Rahmen
 * öffnet beim Seitenaufruf eine Verbindung zu Google oder Meta. Das bricht die
 * Entscheidung, auf der diese Website steht — selbst gehostete Schriften,
 * lokale Bilder, kein Cookie-Banner —, und würde das Banner nachträglich
 * nötig machen.
 *
 * Drei Dinge, die hier nicht verhandelbar sind:
 *
 * 1. **`autoplay` steht nicht im Markup.** Es wird erst per Skript gesetzt,
 *    und nur wenn weder `prefers-reduced-motion` noch die Klasse
 *    `a11y-motion` gesetzt ist. Die CSS-Regel in `a11y.css` deckelt bloß
 *    Animationen und Übergänge — ein `<video autoplay>` liefe davon
 *    unbeeindruckt weiter. Dieselbe Falle wie `behavior: 'smooth'`.
 * 2. **`preload="none"` und Posterbild.** Das Poster ist der sichtbare
 *    Erstinhalt; das Video lädt erst, wenn es wirklich abgespielt wird. Ein
 *    Video, das den Largest Contentful Paint stellt, kostet Rangplätze.
 * 3. **Keine Tonspur.** Sie wird beim Aufbereiten entfernt — das halbiert das
 *    Gewicht, erspart Untertitel und ist ohnehin die einzige Form von
 *    Autoplay, die Browser zulassen.
 *
 * Der `VideoObject`-Block macht das Video für Suchmaschinen überhaupt erst
 * sichtbar. Für Antwortmaschinen zählt er wenig — die lesen `description`,
 * nicht das Bild. Deshalb gehört dort ein Satz hin, der eine echte Frage
 * beantwortet, kein Schlagwort.
 */
import { asset, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Locale;
  src: string;
  poster: string;
  /** Kurzname des Videos für die strukturierten Daten. */
  name: string;
  /** Ein Satz, der beschreibt, was zu sehen ist — der eigentliche SEO-Anteil. */
  description: string;
  /** ISO-Datum der Aufnahme bzw. Veröffentlichung. */
  uploadDate: string;
  /** Dauer nach ISO 8601, z. B. `PT8S`. */
  duration: string;
  class?: string;
}

const { lang, src, poster, name, description, uploadDate, duration, class: klasse } = Astro.props;
const _ = useTranslations(lang);

const videoUrl = new URL(asset(src), Astro.site).href;
const posterUrl = new URL(asset(poster), Astro.site).href;

const videoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name,
  description,
  uploadDate,
  duration,
  thumbnailUrl: posterUrl,
  contentUrl: videoUrl,
};
---

<video
  class:list={['loopvideo', klasse]}
  src={asset(src)}
  poster={asset(poster)}
  preload="none"
  muted
  loop
  playsinline
  aria-label={description}
></video>

{/*
  Ohne diesen Knopf ist eine stumme Schleife, die noch nicht angelaufen ist,
  von einem Foto nicht zu unterscheiden — es gab keinen Hinweis darauf, dass
  hier überhaupt etwas zu sehen wäre. Er ist zugleich die Bedienung für alle,
  bei denen nichts von selbst startet: „Animationen reduzieren“, Datensparmodus
  oder eine Browserregel, die Autoplay verweigert. Steuerung statt Zufall.
*/}
<button
  class="loopvideo-schalter"
  type="button"
  data-zustand="an"
  data-an={_('video.play')}
  data-aus={_('video.pause')}
  aria-label={_('video.play')}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="loopvideo-an" d="M8 5.5v13l11-6.5z" />
    <path class="loopvideo-aus" d="M7.5 5.5h3.5v13H7.5zm5.5 0h3.5v13H13z" />
  </svg>
</button>

<script type="application/ld+json" is:inline set:html={JSON.stringify(videoJsonLd)} />

<script>
  /*
    Erst hier entscheidet sich, ob überhaupt etwas läuft. Beide Quellen zählen:
    die Systemeinstellung und der Schalter im Barrierefreiheits-Panel. Ist eine
    von beiden gesetzt, bleibt das Posterbild stehen — es ist dann kein
    Notbehelf, sondern das Bild.
  */
  function ruhe(): boolean {
    return (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      document.documentElement.classList.contains('a11y-motion')
    );
  }

  const videos = [...document.querySelectorAll<HTMLVideoElement>('.loopvideo')];

  /** Der Knopf, der zu diesem Video gehört — er steht direkt dahinter. */
  function schalterVon(video: HTMLVideoElement): HTMLButtonElement | null {
    return video.parentElement?.querySelector<HTMLButtonElement>('.loopvideo-schalter') ?? null;
  }

  /** Knopfbeschriftung und Symbol an den tatsächlichen Zustand angleichen. */
  function schalterZeigen(video: HTMLVideoElement): void {
    const schalter = schalterVon(video);
    if (!schalter) return;
    const laeuft = !video.paused && !video.ended;
    schalter.dataset.zustand = laeuft ? 'aus' : 'an';
    schalter.setAttribute(
      'aria-label',
      (laeuft ? schalter.dataset.aus : schalter.dataset.an) ?? '',
    );
  }

  function anwenden(): void {
    for (const video of videos) {
      if (ruhe()) {
        video.pause();
        video.removeAttribute('autoplay');
        schalterZeigen(video);
        continue;
      }
      // Erst laden, wenn das Video auch zu sehen ist — sonst holt jede Seite
      // anderthalb Megabyte für etwas, das unter dem Falz liegt.
      if (!video.dataset.sichtbar) continue;
      // Von Hand angehalten heißt angehalten: Ein Video, das beim Scrollen von
      // selbst wieder anspringt, nimmt der Besucherin die Entscheidung ab.
      if (video.dataset.gestoppt) continue;
      video.play().catch(() => {
        /* Der Browser darf ablehnen (Datensparmodus, Akku). Poster bleibt. */
      });
    }
  }

  for (const video of videos) {
    const schalter = schalterVon(video);
    schalter?.addEventListener('click', () => {
      if (video.paused) {
        delete video.dataset.gestoppt;
        video.play().catch(() => {});
      } else {
        video.dataset.gestoppt = 'ja';
        video.pause();
      }
    });
    video.addEventListener('play', () => schalterZeigen(video));
    video.addEventListener('pause', () => schalterZeigen(video));
    schalterZeigen(video);
  }

  const beobachter = new IntersectionObserver(
    (eintraege) => {
      for (const eintrag of eintraege) {
        const video = eintrag.target as HTMLVideoElement;
        if (eintrag.isIntersecting) {
          video.dataset.sichtbar = 'ja';
        } else {
          delete video.dataset.sichtbar;
          video.pause();
        }
      }
      anwenden();
    },
    { rootMargin: '200px' },
  );

  for (const video of videos) beobachter.observe(video);

  // Der Schalter im Panel wirkt sofort, nicht erst beim nächsten Aufruf.
  new MutationObserver(anwenden).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });
  window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', anwenden);
</script>

<style>
  /*
     Absolut im `.ph`-Kasten, genau wie die Bilder dort. Mit bloßem
     `height: 100%` löst die Höhe nicht gegen die `aspect-ratio`-Fläche auf:
     Das Video behielte sein eigenes Hochformat, würde 250 px höher als sein
     Container und säße oben statt mittig. `overflow: hidden` am Elternteil
     verdeckt das — der Ausschnitt wäre trotzdem der falsche.
  */
  .loopvideo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Klein und in der Ecke, nicht mittig über dem Motiv: Der Knopf soll sagen
     „hier bewegt sich etwas“, nicht das Bild zerschneiden. Maße in px, damit
     er bei 150 % Textgröße nicht mitwächst und die Kachel sprengt. */
  .loopvideo-schalter {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    color: var(--cream);
    cursor: pointer;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      opacity 0.25s var(--ease);
  }

  .loopvideo-schalter:hover {
    border-color: var(--gold-lit);
    color: var(--gold-lit);
  }

  .loopvideo-schalter svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Läuft das Video, tritt der Knopf zurück — bis jemand ihn ansteuert. */
  .loopvideo-schalter[data-zustand='aus'] {
    opacity: 0.45;
  }

  .loopvideo-schalter[data-zustand='aus']:hover,
  .loopvideo-schalter[data-zustand='aus']:focus-visible {
    opacity: 1;
  }

  .loopvideo-schalter[data-zustand='an'] .loopvideo-aus,
  .loopvideo-schalter[data-zustand='aus'] .loopvideo-an {
    display: none;
  }
</style>
