---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Locale;
  /** Vorbelegter Nachrichtentext für WhatsApp und E-Mail. */
  message?: string;
  /** Betreff für die E-Mail-Variante. */
  subject?: string;
  /** Überschrift und Einleitung ausblenden, wenn sie schon darüber stehen. */
  bare?: boolean;
  /** Kennzeichnung für das Skript, das den Text nachträglich aktualisiert. */
  id?: string;
}

const { lang, message = '', subject = '', bare = false, id } = Astro.props;
const _ = useTranslations(lang);

const betreff = subject || site.nameFull;

/*
  Keine Formulare: Die Kundschaft schreibt ohnehin per Messenger, und eine
  Nachricht, die sie selbst abschickt, landet direkt in Galas Posteingang —
  ohne Server, ohne Zustellrisiko, ohne Einwilligungskästchen.
*/
const whatsappUrl = site.whatsapp
  ? `https://wa.me/${site.whatsapp}${message ? `?text=${encodeURIComponent(message)}` : ''}`
  : '';
const mailUrl = `mailto:${site.email}?subject=${encodeURIComponent(betreff)}${
  message ? `&body=${encodeURIComponent(message)}` : ''
}`;
---

<div class="channels" data-channels={id}>
  {
    !bare && (
      <>
        <h2 class="channels-title">{_('channels.title')}</h2>
        <p class="muted">{_('channels.text')}</p>
      </>
    )
  }

  <div class="channels-row">
    {
      whatsappUrl && (
        <a class="btn btn--gold" href={whatsappUrl} target="_blank" rel="noopener" data-channel="whatsapp">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2c-5.5 0-9.97 4.47-9.97 9.97 0 1.76.46 3.48 1.34 5L2 22l5.16-1.35a9.94 9.94 0 0 0 4.88 1.25h.01c5.5 0 9.97-4.47 9.97-9.97 0-2.66-1.04-5.17-2.92-7.05A9.9 9.9 0 0 0 12.04 2zm0 18.13h-.01a8.3 8.3 0 0 1-4.22-1.16l-.3-.18-3.13.82.84-3.05-.2-.31a8.26 8.26 0 0 1-1.27-4.4c0-4.57 3.72-8.29 8.3-8.29 2.21 0 4.29.86 5.86 2.43a8.24 8.24 0 0 1 2.42 5.87c0 4.57-3.72 8.27-8.29 8.27zm4.55-6.2c-.25-.13-1.47-.72-1.7-.81-.23-.08-.4-.13-.56.13-.17.25-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.56-.43h-.47c-.16 0-.42.06-.64.31s-.84.82-.84 2 .86 2.32.98 2.48c.12.17 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.15-1.18-.06-.11-.23-.17-.48-.29z" />
          </svg>
          {_('channels.whatsapp')}
        </a>
      )
    }

    <a class="btn btn--ghost" href={site.instagramUrl} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
      </svg>
      {_('channels.instagram')}
    </a>

    {/*
      Kein „Anrufen“: Gala nimmt keine Anrufe entgegen und möchte, dass man ihr
      schreibt. Die Nummer bleibt auf der Kontaktseite und im Impressum stehen —
      dort gehört sie hin — nur als Handlungsaufforderung ist sie weg.
    */}

    <a class="btn btn--ghost" href={mailUrl} data-channel="email">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m2 7 10 6 10-6"></path>
      </svg>
      {_('channels.email')}
    </a>
  </div>

  {!bare && <p class="hint">{_('channels.email.hint')}</p>}
</div>

<style>
  .channels-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-3);
  }

  .channels-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .channels-row .btn {
    padding: 0.8em 1.4em;
  }
</style>
