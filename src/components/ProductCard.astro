---
import { asset, path, t, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { formatPrice, lowestPrice, type Bouquet } from '../data/shop';

interface Props {
  lang: Locale;
  bouquet: Bouquet;
}

const { lang, bouquet } = Astro.props;
const _ = useTranslations(lang);
const name = t(bouquet.name, lang);
const href = path(lang, 'shop', bouquet.slug);
const image = asset(bouquet.images[0]);
---

<article class="product">
  <a class="product-media" href={href} tabindex="-1" aria-hidden="true">
    <div class="ph product-ph" data-label={name}>
      <img src={image} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
    </div>
  </a>

  <div class="product-body">
    <h3 class="product-name"><a href={href}>{name}</a></h3>
    <p class="small muted product-blurb">{t(bouquet.blurb, lang)}</p>
    <p class="product-price">
      <span class="muted small">{_('shop.from')}</span>
      {formatPrice(lowestPrice(bouquet), lang)}
    </p>
  </div>
</article>

<style>
  .product {
    display: flex;
    flex-direction: column;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s var(--ease);
  }

  .product:hover {
    border-color: var(--line-strong);
  }

  .product-media {
    display: block;
    line-height: 0;
  }

  .product-ph {
    aspect-ratio: 4 / 5;
  }

  .product-ph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .product:hover .product-ph img {
    transform: scale(1.04);
  }

  .product-body {
    padding: var(--space-4) var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .product-name {
    font-size: 1.3rem;
    margin: 0;
  }

  .product-name a {
    text-decoration: none;
  }

  /* Ganze Karte klickbar, ohne den Link aus dem Fließtext zu nehmen. */
  .product-name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .product {
    position: relative;
  }

  .product-blurb {
    margin: 0;
    flex: 1;
  }

  .product-price {
    margin: 0;
    font-family: var(--font-display), serif;
    font-size: min(1.35rem, 9vw);
    color: var(--cream);
  }

  .product-price .small {
    font-family: var(--font-body), sans-serif;
    margin-right: 0.3em;
  }
</style>
