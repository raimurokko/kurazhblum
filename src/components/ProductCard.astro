---
import { asset, path, t, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { formatPrice, hasSizes, lowestPrice, type Bouquet } from '../data/shop';

interface Props {
  lang: Locale;
  bouquet: Bouquet;
}

const { lang, bouquet } = Astro.props;
const _ = useTranslations(lang);
const name = t(bouquet.name, lang);
const href = path(lang, 'shop', bouquet.slug);
// Ohne Foto kein `<img>`: Ein Verweis ins Leere holt bei jedem Aufruf eine
// 404, und `onerror` räumt sie nur optisch weg.
const image = bouquet.images[0] ? asset(bouquet.images[0]) : undefined;
---

<article class="product">
  <a class="product-media" href={href} tabindex="-1" aria-hidden="true">
    <div class="ph product-ph" data-label={name}>
      {image && <img src={image} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
      {bouquet.imagePending && (
        <span class="platzhalter-marke platzhalter-marke--folgt">{_('common.imagepending')}</span>
      )}
    </div>
  </a>

  <div class="product-body">
    <h3 class="product-name"><a href={href}>{name}</a></h3>
    <p class="small muted product-blurb">{t(bouquet.blurb, lang)}</p>
    {
      bouquet.priceOnRequest ? (
        <p class="product-price product-price--saison">{_('product.seasonal.price')}</p>
      ) : (
        <p class="product-price">
          {hasSizes(bouquet) && <span class="muted small">{_('shop.from')}</span>}
          {formatPrice(lowestPrice(bouquet), lang)}
        </p>
      )
    }
    {bouquet.surprise && <span class="tag tag--gold product-flag">{_('ways.c.badge')}</span>}
    {bouquet.priceOnRequest && <span class="tag product-flag">{_('product.seasonal.badge')}</span>}
  </div>
</article>

<style>
  .product {
    display: flex;
    flex-direction: column;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-bild);
    overflow: hidden;
    transition: border-color 0.3s var(--ease);
  }

  .product:hover {
    border-color: var(--line-strong);
  }

  .product-media {
    display: block;
    line-height: 0;
  }

  .product-ph {
    aspect-ratio: 4 / 5;
  }

  .product-ph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .product:hover .product-ph img {
    transform: scale(1.04);
  }

  .product-body {
    padding: var(--space-4) var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .product-name {
    font-size: 1.3rem;
    margin: 0;
  }

  .product-name a {
    text-decoration: none;
  }

  /* Ganze Karte klickbar, ohne den Link aus dem Fließtext zu nehmen. */
  .product-name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .product {
    position: relative;
  }

  .product-blurb {
    margin: 0;
    flex: 1;
  }

  .product-price {
    margin: 0;
    font-family: var(--font-display), serif;
    font-size: min(1.35rem, 9vw);
    color: var(--cream);
  }

  .product-flag {
    align-self: flex-start;
  }

  .product-price--saison {
    font-family: var(--font-body), sans-serif;
    font-size: 0.95rem;
    color: var(--gold-lit);
  }

  .product-price .small {
    font-family: var(--font-body), sans-serif;
    margin-right: 0.3em;
  }
</style>
