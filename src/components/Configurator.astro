---
import { asset, t, type Locale } from '../i18n/config';
import { useTranslations, type UiKey } from '../i18n/ui';
import {
  DELIVERY_ZONES,
  EXTRAS,
  MIN_ORDER_DELIVERY,
  PRESENTATION_FROM,
  PRESENTATION_SURCHARGE,
  formatPrice,
  imagesFor,
  priceFor,
  sizesOf,
  surchargeFor,
  type Bouquet,
  type PresentationKey,
  type SizeKey,
} from '../data/shop';
import { DELIVERY_SLOTS, site } from '../data/site';

interface Props {
  lang: Locale;
  bouquet: Bouquet;
}

const { lang, bouquet } = Astro.props;
const _ = useTranslations(lang);

/** Leer bei Festpreis-Produkten — dann entfällt die Größenwahl ganz. */
const sizes: SizeKey[] = sizesOf(bouquet);
const presentations = bouquet.presentations;

/** Erstes Foto je Größe, damit die Produktseite beim Wechsel mittauscht. */
const bildJeGroesse = Object.fromEntries(sizes.map((size) => [size, asset(imagesFor(bouquet, size)[0])]));

/**
 * Der Preis wird zweimal berechnet: hier im Browser für die Live-Anzeige und
 * noch einmal serverseitig in /api/checkout. Der Serverwert ist der
 * verbindliche — der Browser darf nur anzeigen, nie festlegen.
 */
const pricing = {
  currencyLocale: lang,
  /** Festpreis-Produkte bekommen eine Pseudo-Größe, damit die Rechnung gleich bleibt. */
  sizes: sizes.length ? bouquet.prices : { fixed: priceFor(bouquet) },
  /** Je Form ein Satz Aufpreise nach Größe; `null` = in dieser Größe nicht im Angebot. */
  presentations: Object.fromEntries(presentations.map((p) => [p, PRESENTATION_SURCHARGE[p]])),
  extras: Object.fromEntries(EXTRAS.map((e) => [e.id, e.price])),
  zones: Object.fromEntries(DELIVERY_ZONES.map((z) => [z.id, z.fee])),
  minOrderDelivery: MIN_ORDER_DELIVERY,
  /** Formen mit Ab-Preis — das Gefäß wird vor der Lieferung abgestimmt. */
  from: PRESENTATION_FROM,
  fromLabel: _('shop.from'),
  freeLabel: _('common.free'),
};

/** Größe, die beim ersten Rendern ausgewählt ist — ohne Staffel die Pseudo-Größe. */
const startSize: SizeKey | 'fixed' = sizes[0] ?? 'fixed';

/**
 * Preisschild einer Form. Ohne JavaScript steht hier bereits der richtige
 * Betrag für die vorausgewählte Größe; die Skripte rechnen beim Wechsel um.
 */
function priceLabel(presentation: PresentationKey, size: SizeKey | 'fixed'): string {
  const cents = surchargeFor(presentation, size);
  if (cents === null) return '';
  if (cents === 0) return _('common.free');
  const betrag = `+ ${formatPrice(cents, lang)}`;
  return PRESENTATION_FROM.includes(presentation) ? `${_('shop.from')} ${betrag}` : betrag;
}

/** Extras haben weiter einen festen Preis, unabhängig von der Größe. */
const extraLabel = (cents: number) => (cents === 0 ? _('common.free') : `+ ${formatPrice(cents, lang)}`);

// Frühester Liefertermin: morgen. Same-day läuft telefonisch, das ist ehrlicher
// als ein Formular, das den Redaktionsschluss nicht kennt.
const tomorrow = new Date();
tomorrow.setDate(tomorrow.getDate() + 1);
const minDate = tomorrow.toISOString().slice(0, 10);
---

<form
  class="cfg panel"
  data-configurator
  data-slug={bouquet.slug}
  data-lang={lang}
  data-min-warning={_('cfg.minorder.short')}
  data-busy-label={_('cfg.loading')}
  data-endpoint={asset('/api/checkout')}
  data-images={JSON.stringify(bildJeGroesse)}
>
  <h2 class="cfg-title">{_('cfg.title')}</h2>

  <!-- Größe — entfällt bei Festpreis-Produkten -->
  {
    sizes.length > 0 && (
      <fieldset class="cfg-block">
        <legend class="field-label">{_('cfg.size')}</legend>
        <div class="choices choices--row">
          {sizes.map((size, index) => (
            <label class="choice">
              <input type="radio" name="size" value={size} checked={index === 0} />
              <span class="choice-title">{_(`cfg.size.${size}` as UiKey)}</span>
              <span class="choice-desc">{_(`cfg.size.${size}.desc` as UiKey)}</span>
              <span class="choice-price">
                {_('shop.from')} {formatPrice(priceFor(bouquet, size), lang)}
              </span>
            </label>
          ))}
        </div>
        <p class="hint">{_('cfg.size.hint')}</p>
      </fieldset>
    )
  }

  {
    sizes.length === 0 && (
      <input type="hidden" name="size" value="fixed" />
    )
  }

  <!-- Präsentation -->
  <fieldset class="cfg-block">
    <legend class="field-label">{_('cfg.presentation')}</legend>
    <div class="choices choices--row">
      {
        presentations.map((presentation: PresentationKey, index: number) => (
          <label class="choice" data-presentation={presentation} hidden={surchargeFor(presentation, startSize) === null}>
            <input
              type="radio"
              name="presentation"
              value={presentation}
              checked={index === 0}
              disabled={surchargeFor(presentation, startSize) === null}
            />
            <span class="choice-title">{_(`cfg.presentation.${presentation}` as UiKey)}</span>
            <span class="choice-desc">{_(`cfg.presentation.${presentation}.desc` as UiKey)}</span>
            <span class="choice-price">{priceLabel(presentation, startSize)}</span>
          </label>
        ))
      }
    </div>
    <p class="hint">{_('cfg.presentation.hint')}</p>
  </fieldset>

  <!-- Grußkarte -->
  <fieldset class="cfg-block">
    <legend class="field-label">{_('cfg.card')} <span class="tag tag--gold">{_('cfg.card.free')}</span></legend>
    <label class="switch">
      <input type="checkbox" name="card" data-card-toggle />
      <span>{_('cfg.card.yes')}</span>
    </label>
    <div class="cfg-card-body" hidden data-card-body>
      <label class="field">
        <span class="field-label">{_('cfg.card.message')}</span>
        <textarea
          class="textarea"
          name="cardMessage"
          maxlength="240"
          rows="3"
          placeholder={_('cfg.card.placeholder')}
          data-card-message></textarea>
      </label>
      <p class="hint"><span data-card-count>0</span>/240 {_('cfg.card.counter')}</p>
    </div>
  </fieldset>

  <!--
    Rechnung per E-Mail: Firmen brauchen sie, Privatleute meist nicht. Deshalb
    zum Ankreuzen statt als Pflichtfeld — wer sie nicht braucht, sieht nur eine
    Zeile mehr. Die Adresse holt Stripe an der Kasse ohnehin ein.
  -->
  <fieldset class="cfg-block">
    <legend class="field-label">{_('cfg.invoice')}</legend>
    <label class="switch">
      <input type="checkbox" name="invoice" data-invoice-toggle />
      <span>{_('cfg.invoice.yes')}</span>
    </label>
    <p class="hint">{_('cfg.invoice.hint')}</p>
  </fieldset>

  <!-- Extras -->
  <fieldset class="cfg-block">
    <legend class="field-label">{_('cfg.extras')}</legend>
    <div class="choices">
      {
        EXTRAS.map((extra) => (
          <label class="choice choice--inline">
            <input type="checkbox" name="extras" value={extra.id} />
            <span class="choice-title">{t(extra.name, lang)}</span>
            <span class="choice-price">{extraLabel(extra.price)}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <!-- Lieferung -->
  <fieldset class="cfg-block">
    <legend class="field-label">{_('cfg.delivery')}</legend>

    <label class="field">
      <span class="field-label">{_('cfg.delivery.zone')}</span>
      <!-- Zone A ist die häufigste. „Abholung“ als Vorauswahl würde
           Lieferkosten und Mindestbestellwert stillschweigend ausblenden. -->
      <select class="select" name="zone" required>
        {
          DELIVERY_ZONES.map((zone) => (
            <option value={zone.id} selected={zone.id === 'a'} data-hint={t(zone.hint, lang)} data-name={t(zone.name, lang)}>
              {t(zone.name, lang)} — {zone.fee === 0 ? _('common.free') : formatPrice(zone.fee, lang)}
            </option>
          ))
        }
      </select>
      <span class="hint" data-zone-hint></span>
    </label>

    <p class="hint">{_('cfg.delivery.beyond')}</p>

    <div class="cfg-row">
      <label class="field">
        <span class="field-label">{_('cfg.delivery.date')}</span>
        <input class="input" type="date" name="date" min={minDate} required />
      </label>

      <label class="field">
        <span class="field-label">{_('cfg.delivery.slot')}</span>
        <select class="select" name="slot">
          {DELIVERY_SLOTS.map((slot) => <option value={slot.id}>{t(slot.label, lang)}</option>)}
        </select>
      </label>
    </div>
  </fieldset>

  <!-- Zusammenfassung -->
  <div class="cfg-summary">
    <h3 class="field-label">{_('cfg.summary')}</h3>
    <dl class="cfg-lines" data-lines></dl>

    <div class="cfg-total">
      <span>{_('cfg.total')}</span>
      <strong data-total>{formatPrice(priceFor(bouquet, sizes[0]), lang)}</strong>
    </div>
    <p class="hint">{_('cfg.incl_vat')}</p>

    <p class="cfg-warn" hidden data-min-warning></p>

    <button class="btn btn--primary btn--block" type="submit" data-submit>{_('cfg.order')}</button>
    <p class="hint">{_('cfg.minorder')}</p>
    <p class="cfg-error" hidden data-error>
      {_('form.error')}<br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.whatsapp && (
        <>
          {' · '}
          <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
            {_('channels.whatsapp')}
          </a>
        </>
      )}
    </p>
  </div>

  <script type="application/json" data-pricing is:inline set:html={JSON.stringify(pricing)} />
</form>

<style>
  .cfg-title {
    font-size: 1.6rem;
    margin-bottom: var(--space-5);
  }

  .cfg-block {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-6);
  }

  .cfg-block legend {
    padding: 0;
    margin-bottom: var(--space-3);
  }

  .cfg-row {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
  }

  .cfg-row .field {
    margin-bottom: 0;
  }

  .choice--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .choice--inline > * {
    min-width: 0;
  }

  .choice--inline .choice-price {
    margin-top: 0;
    white-space: nowrap;
  }

  .switch {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .switch input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--gold-lit);
  }

  .cfg-card-body {
    margin-top: var(--space-4);
  }

  .cfg-card-body .field {
    margin-bottom: var(--space-2);
  }

  .cfg-summary {
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-5);
  }

  .cfg-lines {
    margin: var(--space-3) 0 var(--space-4);
    display: grid;
    gap: var(--space-2);
    font-size: 0.9rem;
  }

  .cfg-lines > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--cream-2);
  }

  .cfg-lines dt {
    margin: 0;
  }

  .cfg-lines dd {
    margin: 0;
    white-space: nowrap;
  }

  .cfg-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream-2);
  }

  .cfg-total strong {
    font-family: var(--font-display), serif;
    font-size: min(2rem, 10vw);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--cream);
  }

  .cfg-warn,
  .cfg-error {
    margin: var(--space-3) 0;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--gold);
    background: rgb(144 112 64 / 0.12);
    font-size: 0.88rem;
    color: var(--cream-2);
  }

  .cfg-error {
    border-left-color: var(--mauve-deep);
    background: rgb(142 112 120 / 0.14);
  }

  .cfg-summary .btn {
    margin-top: var(--space-3);
  }
</style>

<script>
  type Pricing = {
    currencyLocale: string;
    sizes: Record<string, number>;
    /** Aufpreis je Form **und Größe**; null = in dieser Größe nicht im Angebot. */
    presentations: Record<string, Record<string, number | null>>;
    extras: Record<string, number>;
    zones: Record<string, number>;
    minOrderDelivery: number;
    from: string[];
    fromLabel: string;
    freeLabel: string;
  };

  const INTL_LOCALE: Record<string, string> = { de: 'de-DE', uk: 'uk-UA', en: 'en-IE', ru: 'ru-RU' };

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-configurator]')) {
    const pricingEl = form.querySelector<HTMLScriptElement>('[data-pricing]');
    if (!pricingEl?.textContent) continue;

    const pricing: Pricing = JSON.parse(pricingEl.textContent);
    const lang = form.dataset.lang ?? 'de';
    const slug = form.dataset.slug ?? '';
    const money = new Intl.NumberFormat(INTL_LOCALE[lang] ?? 'de-DE', {
      style: 'currency',
      currency: 'EUR',
      currencyDisplay: 'narrowSymbol',
    });
    const fmt = (cents: number) => money.format(cents / 100);

    const totalEl = form.querySelector<HTMLElement>('[data-total]');
    const linesEl = form.querySelector<HTMLElement>('[data-lines]');
    const warnEl = form.querySelector<HTMLElement>('[data-min-warning]');
    const errorEl = form.querySelector<HTMLElement>('[data-error]');
    const submitEl = form.querySelector<HTMLButtonElement>('[data-submit]');
    const zoneHintEl = form.querySelector<HTMLElement>('[data-zone-hint]');
    const cardToggle = form.querySelector<HTMLInputElement>('[data-card-toggle]');
    const cardBody = form.querySelector<HTMLElement>('[data-card-body]');
    const cardMessage = form.querySelector<HTMLTextAreaElement>('[data-card-message]');
    const cardCount = form.querySelector<HTMLElement>('[data-card-count]');

    const minWarningTemplate = form.dataset.minWarning ?? '';

    /*
      Fotos je Größe: Gala hat M, L und XL einzeln fotografiert. Beim Wechsel
      tauscht das Bild auf der Produktseite mit — so sieht man, was man
      bekommt, statt es aus einer Zahl schließen zu müssen.
    */
    let bilder: Record<string, string> = {};
    try {
      bilder = JSON.parse(form.dataset.images ?? '{}');
    } catch {
      /* kaputtes Attribut — dann bleibt das Bild einfach stehen */
    }

    const produktBild = document.querySelector<HTMLImageElement>('[data-product-image]');

    function bildAktualisieren(size: string) {
      const quelle = bilder[size];
      if (!produktBild || !quelle || produktBild.getAttribute('src') === quelle) return;
      produktBild.setAttribute('src', quelle);
      produktBild.removeAttribute('srcset');
    }

    function readSelection() {
      const data = new FormData(form);
      const size = String(data.get('size') ?? 'm');
      const presentation = String(data.get('presentation') ?? 'bouquet');
      const zone = String(data.get('zone') ?? 'inner');
      const extras = data.getAll('extras').map(String);
      return { size, presentation, zone, extras };
    }

    function labelFor(name: string, value: string): string {
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
      return input?.closest('.choice')?.querySelector('.choice-title')?.textContent?.trim() ?? value;
    }

    /*
      Ein Korb für einen XL-Strauß kostet mehr als für einen M-Strauß, und zum
      XL-Strauß gibt es gar keine Vase. Beim Größenwechsel müssen deshalb nicht
      nur die Beträge nachziehen, sondern auch die Auswahl selbst: Formen ohne
      Preis für diese Größe verschwinden.

      `hidden` statt `visibility`, weil die Kachel sonst als Lücke im Raster
      stehen bliebe; `disabled` dazu, damit sie aus Tab-Reihenfolge und
      FormData fällt. Wer eine Form gewählt hatte, die es in der neuen Größe
      nicht gibt, landet auf der ersten verbliebenen — stillschweigend eine
      Vase zu berechnen, die nicht geliefert werden kann, wäre schlimmer.
    */
    function formenAktualisieren(size: string): void {
      let gewaehltesWegGefallen = false;

      for (const label of form.querySelectorAll<HTMLElement>('[data-presentation]')) {
        const key = label.dataset.presentation ?? '';
        const cents = pricing.presentations[key]?.[size] ?? null;
        const input = label.querySelector<HTMLInputElement>('input');
        const preis = label.querySelector<HTMLElement>('.choice-price');

        const verfuegbar = cents !== null;
        label.hidden = !verfuegbar;
        if (input) {
          if (!verfuegbar && input.checked) gewaehltesWegGefallen = true;
          input.disabled = !verfuegbar;
        }

        if (preis && verfuegbar) {
          if (cents === 0) {
            preis.textContent = pricing.freeLabel;
          } else {
            const betrag = `+ ${fmt(cents)}`;
            preis.textContent = pricing.from.includes(key) ? `${pricing.fromLabel} ${betrag}` : betrag;
          }
        }
      }

      if (gewaehltesWegGefallen) {
        const ersatz = form.querySelector<HTMLInputElement>(
          'input[name="presentation"]:not(:disabled)',
        );
        if (ersatz) ersatz.checked = true;
      }
    }

    function render() {
      const { size } = readSelection();
      formenAktualisieren(size);

      // Erst nach dem Umschalten lesen: Die Auswahl kann sich gerade
      // verschoben haben, wenn eine Form für diese Größe entfallen ist.
      const { presentation, zone, extras } = readSelection();
      bildAktualisieren(size);

      const base = pricing.sizes[size] ?? 0;
      const surcharge = pricing.presentations[presentation]?.[size] ?? 0;
      const extrasTotal = extras.reduce((sum, id) => sum + (pricing.extras[id] ?? 0), 0);
      const delivery = pricing.zones[zone] ?? 0;
      const subtotal = base + surcharge + extrasTotal;
      const total = subtotal + delivery;

      if (totalEl) totalEl.textContent = fmt(total);

      if (linesEl) {
        const rows: [string, string][] = [[labelFor('size', size), fmt(base)]];
        if (surcharge > 0) rows.push([labelFor('presentation', presentation), `+ ${fmt(surcharge)}`]);
        for (const id of extras) {
          rows.push([labelFor('extras', id), `+ ${fmt(pricing.extras[id] ?? 0)}`]);
        }
        const zoneOption = form.querySelector<HTMLSelectElement>('[name="zone"]')?.selectedOptions[0];
        rows.push([zoneOption?.dataset.name ?? '', delivery === 0 ? '—' : `+ ${fmt(delivery)}`]);

        linesEl.replaceChildren(
          ...rows.map(([label, value]) => {
            const row = document.createElement('div');
            const dt = document.createElement('dt');
            dt.textContent = label;
            const dd = document.createElement('dd');
            dd.textContent = value;
            row.append(dt, dd);
            return row;
          }),
        );
      }

      // Mindestbestellwert gilt nur, wenn geliefert wird.
      const needsMinimum = zone !== 'pickup' && subtotal < pricing.minOrderDelivery;
      if (warnEl) {
        warnEl.hidden = !needsMinimum;
        if (needsMinimum) {
          warnEl.textContent = minWarningTemplate.replace('{amount}', fmt(pricing.minOrderDelivery - subtotal));
        }
      }
      if (submitEl) submitEl.disabled = needsMinimum;

      if (zoneHintEl) {
        const selected = form.querySelector<HTMLSelectElement>('[name="zone"]');
        zoneHintEl.textContent = selected?.selectedOptions[0]?.dataset.hint ?? '';
      }
    }

    form.addEventListener('change', render);
    form.addEventListener('input', () => {
      if (cardCount && cardMessage) cardCount.textContent = String(cardMessage.value.length);
    });

    cardToggle?.addEventListener('change', () => {
      if (cardBody) cardBody.hidden = !cardToggle.checked;
      if (cardToggle.checked) cardMessage?.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const { size, presentation, zone, extras } = readSelection();

      const submitLabel = submitEl?.textContent ?? '';
      if (submitEl) {
        submitEl.disabled = true;
        submitEl.textContent = form.dataset.busyLabel ?? submitLabel;
      }
      if (errorEl) errorEl.hidden = true;

      try {
        const response = await fetch(form.dataset.endpoint ?? '/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lang,
            slug,
            size,
            presentation,
            zone,
            extras,
            date: data.get('date'),
            slot: data.get('slot'),
            cardMessage: cardToggle?.checked ? String(data.get('cardMessage') ?? '') : '',
            invoice: data.get('invoice') === 'on',
          }),
        });

        if (!response.ok) throw new Error(`checkout failed: ${response.status}`);
        const result = (await response.json()) as { url?: string };
        if (!result.url) throw new Error('checkout returned no url');
        window.location.href = result.url;
      } catch (error) {
        console.error(error);
        if (errorEl) errorEl.hidden = false;
        if (submitEl) {
          submitEl.disabled = false;
          submitEl.textContent = submitLabel;
        }
      }
    });

    render();
  }
</script>
