---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactChannels from '../../../components/ContactChannels.astro';
import { localePaths, t, type Locale } from '../../../i18n/config';
import { useTranslations, type UiKey } from '../../../i18n/ui';
import { FLOWERS } from '../../../data/flowers';
import { SIZES, SIZE_ENTRY_PRICES, formatPrice } from '../../../data/shop';
import { DELIVERY_SLOTS, SUNDAY_LAST_START } from '../../../data/site';
import { asset } from '../../../i18n/config';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const _ = useTranslations(lang);

const stimmungen = ['light', 'bright', 'dark', 'mono'] as const;

/*
  Budgetstufen. Die ersten drei sind die Einstiegspreise der Staffel, die
  letzte ist die offene Stufe nach oben. Weil Größe und Budget getrennt
  gewählt werden, blendet das Skript unten alle Stufen aus, die unter dem
  Einstieg der gewählten Größe liegen — sonst ließe sich ein XL-Strauß für
  85 € anfragen, und Gala müsste die Anfrage mit einer Absage beantworten.
*/
const budgets = [SIZE_ENTRY_PRICES.m, SIZE_ENTRY_PRICES.l, SIZE_ENTRY_PRICES.xl, 35000];

/** Frühester Termin: morgen — dieselbe Zusage wie im Konfigurator. */
const morgen = new Date();
morgen.setDate(morgen.getDate() + 1);
const minDate = morgen.toISOString().slice(0, 10);

/*
  Weg A endet bewusst nicht im Warenkorb. Gala hat kein Lager — was heute da
  ist, entscheidet der Markt am Morgen. Statt eines Formulars, das erst auf
  einem Server landen müsste, baut die Seite aus der Auswahl eine fertige
  Nachricht: die Kundin schickt sie selbst per WhatsApp oder E-Mail ab. Das
  läuft ohne Server, ohne Einwilligungskästchen und kommt sofort an.
*/
---

<BaseLayout lang={lang} title={_('build.title')} description={_('build.intro')} route="shop/zusammenstellen">
  <section class="section">
    <div class="wrap wrap-narrow">
      <span class="kicker">{_('build.kicker')}</span>
      <h1>{_('build.title')}</h1>
      <p class="lead">{_('build.intro')}</p>
      <p class="small muted why">{_('build.why')}</p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap wrap-narrow">
      <form class="panel builder" data-builder data-sonntag-grenze={SUNDAY_LAST_START}>
        <!-- Blumen -->
        <fieldset class="build-block">
          <legend class="field-label">{_('build.flowers')}</legend>
          <div class="choices choices--row">
            {
              FLOWERS.map((flower) => (
                <label class="choice choice--inline">
                  <input type="checkbox" name="flowers" value={t(flower.name, lang)} />
                  <span class="choice-title">{t(flower.name, lang)}</span>
                </label>
              ))
            }
          </div>
          <p class="hint">{_('build.flowers.hint')}</p>

          {/*
            Die Liste sagt, womit Gala regelmäßig arbeitet — sie ist keine
            Grenze. Wer Wicken, Mohn oder Flieder möchte, schreibt es hier
            hinein, statt es in die Anmerkung zu quetschen, wo es zwischen
            Anlass und Lieferadresse untergeht.
          */}
          <label class="field build-eigene">
            <span class="field-label">{_('build.flowers.own')}</span>
            <input class="input" type="text" name="ownFlowers" placeholder={_('build.flowers.own.placeholder')} />
          </label>
        </fieldset>

        <!-- Farbstimmung -->
        <fieldset class="build-block">
          <legend class="field-label">{_('build.mood')}</legend>
          <div class="choices choices--row">
            {
              stimmungen.map((mood, index) => (
                <label class="choice">
                  <input type="radio" name="mood" value={_(`build.mood.${mood}` as UiKey)} checked={index === 1} />
                  <span class="choice-title">{_(`build.mood.${mood}` as UiKey)}</span>
                  <span class="choice-desc">{_(`build.mood.${mood}.desc` as UiKey)}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- Größe und Budget -->
        <div class="build-row">
          <label class="field">
            <span class="field-label">{_('cfg.size')}</span>
            <select class="select" name="size" data-size>
              {
                SIZES.map((size) => (
                  <option value={_(`cfg.size.${size}` as UiKey)} data-min={SIZE_ENTRY_PRICES[size]}>
                    {_(`cfg.size.${size}` as UiKey)} ({_('shop.from')} {formatPrice(SIZE_ENTRY_PRICES[size], lang)})
                  </option>
                ))
              }
            </select>
          </label>

          <label class="field">
            <span class="field-label">{_('build.budget')}</span>
            <select class="select" name="budget" data-budget>
              {
                budgets.map((cents, index) => (
                  <option
                    value={`${index === budgets.length - 1 ? '' : 'ca. '}${formatPrice(cents, lang)}`}
                    data-cents={cents}
                  >
                    {index === budgets.length - 1 ? `${formatPrice(cents, lang)} +` : `ca. ${formatPrice(cents, lang)}`}
                  </option>
                ))
              }
            </select>
          </label>
        </div>

        <p class="hint build-hint">{_('build.budget.hint')}</p>

        <label class="field">
          <span class="field-label">{_('build.note')}</span>
          <textarea class="textarea" name="note" rows="3" placeholder={_('build.note.placeholder')}></textarea>
        </label>

        <!--
          Ab hier ist es eine Bestellung und kein Stimmungsbild mehr. Weg A
          führt weiterhin nicht in die Kasse — die Verfügbarkeit klärt Gala
          vorher —, aber alles, was sie zum Binden und Ausfahren braucht,
          gehört in dieselbe Nachricht. Sonst folgen drei Rückfragen.
        -->
        <fieldset class="build-block">
          <legend class="field-label">{_('build.contact')}</legend>
          <div class="build-row">
            <label class="field">
              <span class="field-label">{_('form.firstname')}</span>
              <input class="input" type="text" name="firstName" autocomplete="given-name" />
            </label>
            <label class="field">
              <span class="field-label">{_('form.lastname')}</span>
              <input class="input" type="text" name="lastName" autocomplete="family-name" />
            </label>
          </div>
          <div class="build-row">
            <label class="field">
              <span class="field-label">{_('form.email')}</span>
              <input class="input" type="email" name="email" autocomplete="email" />
            </label>
            <label class="field">
              <span class="field-label">{_('form.phone')}</span>
              <input class="input" type="tel" name="phone" autocomplete="tel" />
            </label>
          </div>
        </fieldset>

        <fieldset class="build-block">
          <legend class="field-label">{_('cfg.delivery')}</legend>
          <div class="build-row">
            <label class="field">
              <span class="field-label">{_('cfg.delivery.date')}</span>
              <input class="input" type="date" name="deliveryDate" min={minDate} />
              <span class="hint" data-wochentag></span>
            </label>
            <label class="field">
              <span class="field-label">{_('cfg.delivery.slot')}</span>
              <select class="select" name="slot" data-slot>
                {
                  DELIVERY_SLOTS.map((slot) => (
                    <option value={t(slot.label, lang)} data-from={slot.from} selected={slot.from === 14}>
                      {t(slot.label, lang)}
                      {slot.fee > 0 ? ` — + ${formatPrice(slot.fee, lang)}` : ''}
                    </option>
                  ))
                }
              </select>
            </label>
          </div>
          <p class="hint">{_('cfg.delivery.early')}</p>

          <div class="build-row">
            <label class="field">
              <span class="field-label">{_('cfg.delivery.street')}</span>
              <input
                class="input"
                type="text"
                name="street"
                list="build-orte"
                autocomplete="off"
                data-orte={asset('/data/berlin-strassen.json')}
              />
              <datalist id="build-orte" />
            </label>
            <label class="field">
              <span class="field-label">{_('cfg.delivery.number')}</span>
              <input class="input" type="text" name="houseNumber" />
            </label>
          </div>

          <div class="build-row">
            <label class="field">
              <span class="field-label">{_('cfg.delivery.zip')}</span>
              <input class="input" type="text" name="zip" inputmode="numeric" autocomplete="postal-code" />
            </label>
            <label class="field">
              <span class="field-label">{_('cfg.delivery.extra')}</span>
              <input class="input" type="text" name="addressNote" />
            </label>
          </div>
        </fieldset>

        <label class="field">
          <span class="field-label">{_('cfg.card.message')}</span>
          <textarea class="textarea" name="cardMessage" rows="2" maxlength="240" placeholder={_('cfg.card.placeholder')}></textarea>
        </label>

        <!-- Zusammenfassung -->
        <div class="build-summary">
          <h2 class="field-label">{_('build.summary')}</h2>
          <p class="build-preview" data-preview>{_('build.summary.empty')}</p>
          <p class="hint">{_('cfg.minorder')}</p>
        </div>
      </form>

      <div class="build-send">
        <h2 class="send-title">{_('build.send')}</h2>
        <p class="hint">{_('build.send.hint')}</p>
        <ContactChannels lang={lang} bare id="builder" subject={_('build.kicker')} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .why {
    max-width: var(--measure);
    padding-left: var(--space-4);
    border-left: 1px solid var(--line-strong);
  }

  .build-block {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-6);
    min-width: 0;
  }

  .build-block legend {
    padding: 0;
    margin-bottom: var(--space-3);
  }

  .build-row {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
  }

  .build-summary {
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-5);
    margin-top: var(--space-4);
  }

  .build-preview {
    white-space: pre-line;
    color: var(--cream-2);
    font-size: 0.95rem;
    margin: var(--space-3) 0 var(--space-4);
  }

  .build-send {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
  }

  .send-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-builder]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  const channels = document.querySelector<HTMLElement>('[data-channels="builder"]');

  if (form && preview && channels) {
    const leer = preview.textContent ?? '';
    const whatsappLink = channels.querySelector<HTMLAnchorElement>('[data-channel="whatsapp"]');
    const mailLink = channels.querySelector<HTMLAnchorElement>('[data-channel="email"]');

    // Beschriftungen aus dem Formular ziehen, damit die Nachricht in der
    // Sprache der Seite entsteht — ohne die Texte hier zu wiederholen.
    const label = (name: string): string =>
      form
        .querySelector(`[name="${name}"]`)
        ?.closest('.field, fieldset')
        ?.querySelector('.field-label')
        ?.textContent?.replace(/\s+/g, ' ')
        .trim() ?? name;

    /*
      Die Nachricht liest das Formular ab, statt eine zweite Liste von Feldern
      zu pflegen: Wer unten ein Feld ergänzt, muss hier nichts nachtragen.
      Leere Felder fallen weg — eine Zeile „Telefon:“ ohne Nummer sagt weniger
      als gar keine.
    */
    function nachricht(): string {
      const data = new FormData(form!);
      const zeilen: string[] = [];

      const blumen = data.getAll('flowers').map(String);
      const eigene = String(data.get('ownFlowers') ?? '').trim();
      const alleBlumen = [...blumen, ...(eigene ? [eigene] : [])];
      if (alleBlumen.length) zeilen.push(`${label('flowers')}: ${alleBlumen.join(', ')}`);

      for (const feld of form!.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input:not([type="checkbox"]), select, textarea',
      )) {
        if (feld.name === 'ownFlowers' || !feld.value.trim()) continue;
        // Radioknöpfe stehen alle im Formular, gemeint ist nur der gewählte.
        if (feld instanceof HTMLInputElement && feld.type === 'radio' && !feld.checked) continue;
        // Die sichtbare Beschriftung, nicht der Wert: Bei Größe und Fenster
        // trägt sie den Preis beziehungsweise den Aufschlag mit.
        const wert =
          feld instanceof HTMLSelectElement
            ? feld.selectedOptions[0]?.textContent?.trim() ?? feld.value
            : feld.value.trim();
        zeilen.push(`${label(feld.name)}: ${wert}`);
      }

      return zeilen.join('\n');
    }

    /*
      Größe und Budget hängen zusammen: Ein XL-Strauß beginnt bei 220 €, eine
      Anfrage über „ca. 85 €“ wäre für ihn nicht erfüllbar. Stufen darunter
      verschwinden, statt nur gesperrt zu werden — eine ausgegraute Option
      lädt zum Klicken ein und erklärt nichts.
    */
    const sizeSelect = form.querySelector<HTMLSelectElement>('[data-size]');
    const budgetSelect = form.querySelector<HTMLSelectElement>('[data-budget]');

    function budgetsFiltern(): void {
      if (!sizeSelect || !budgetSelect) return;
      const einstieg = Number(sizeSelect.selectedOptions[0]?.dataset.min ?? 0);

      let ersteGueltige: HTMLOptionElement | null = null;
      for (const option of budgetSelect.options) {
        const passt = Number(option.dataset.cents ?? 0) >= einstieg;
        option.hidden = !passt;
        option.disabled = !passt;
        if (passt && !ersteGueltige) ersteGueltige = option;
      }
      if (budgetSelect.selectedOptions[0]?.disabled && ersteGueltige) ersteGueltige.selected = true;
    }

    /*
      Wochentag und Sonntagsregel, wie im Konfigurator: Sonntags schließt das
      Atelier um 16 Uhr. Ein Fenster danach anzubieten hieße, eine Fahrt
      zuzusagen, die niemand macht — auch wenn diese Nachricht erst noch
      bestätigt wird.
    */
    const INTL_LOCALE: Record<string, string> = { de: 'de-DE', uk: 'uk-UA', en: 'en-IE', ru: 'ru-RU' };
    const seitenSprache = document.documentElement.lang || 'de';
    const datumFeld = form.querySelector<HTMLInputElement>('[name="deliveryDate"]');
    const slotFeld = form.querySelector<HTMLSelectElement>('[data-slot]');
    const wochentagEl = form.querySelector<HTMLElement>('[data-wochentag]');
    const sonntagGrenze = Number(form.dataset.sonntagGrenze ?? 15);

    function datumPruefen(): void {
      if (!datumFeld?.value || !slotFeld) return;
      // Ortszeit erzwingen: `new Date('2027-06-12')` wäre UTC-Mitternacht.
      const [jahr, monat, tag] = datumFeld.value.split('-').map(Number);
      const datum = new Date(jahr, monat - 1, tag);

      if (wochentagEl) {
        wochentagEl.textContent = datum.toLocaleDateString(INTL_LOCALE[seitenSprache] ?? 'de-DE', {
          weekday: 'long',
        });
      }

      const istSonntag = datum.getDay() === 0;
      let ersteGueltige: HTMLOptionElement | null = null;
      for (const option of slotFeld.options) {
        const passt = !istSonntag || Number(option.dataset.from ?? 0) <= sonntagGrenze;
        option.hidden = !passt;
        option.disabled = !passt;
        if (passt && !ersteGueltige) ersteGueltige = option;
      }
      if (slotFeld.selectedOptions[0]?.disabled && ersteGueltige) ersteGueltige.selected = true;
    }

    /* Straßenvorschläge aus derselben lokalen Berliner Liste — kein Geocoder. */
    const strasseFeld = form.querySelector<HTMLInputElement>('[name="street"][data-orte]');
    const strasseListe = form.querySelector<HTMLDataListElement>('#build-orte');

    if (strasseFeld && strasseListe) {
      let strassen: string[] | null = null;
      let laden: Promise<void> | null = null;

      const strassenLaden = (): Promise<void> => {
        laden ??= fetch(strasseFeld.dataset.orte ?? '')
          .then((antwort) => (antwort.ok ? antwort.json() : []))
          .then((daten) => {
            strassen = Array.isArray(daten) ? daten : [];
          })
          .catch(() => {
            strassen = [];
          });
        return laden;
      };

      const vorschlagen = (): void => {
        const eingabe = strasseFeld.value.trim().toLowerCase();
        if (!strassen || eingabe.length < 2) {
          strasseListe.replaceChildren();
          return;
        }
        const beginnt: string[] = [];
        const enthaelt: string[] = [];
        for (const strasse of strassen) {
          const klein = strasse.toLowerCase();
          if (klein.startsWith(eingabe)) beginnt.push(strasse);
          else if (klein.includes(eingabe)) enthaelt.push(strasse);
          if (beginnt.length >= 20) break;
        }
        strasseListe.replaceChildren(
          ...[...beginnt, ...enthaelt].slice(0, 20).map((strasse) => {
            const option = document.createElement('option');
            option.value = strasse;
            return option;
          }),
        );
      };

      strasseFeld.addEventListener('focus', () => void strassenLaden().then(vorschlagen), { once: true });
      strasseFeld.addEventListener('input', () => void strassenLaden().then(vorschlagen));
    }

    // Am Formular statt am Feld: So greift die Regel auch, wenn die Eingabe
    // anders zustande kommt als durch Tippen — etwa beim Wiederherstellen.
    form.addEventListener('change', datumPruefen);
    datumPruefen();

    function render() {
      budgetsFiltern();
      const text = nachricht();
      const daten = new FormData(form!);
      const blumenGewaehlt =
        daten.getAll('flowers').length > 0 || String(daten.get('ownFlowers') ?? '').trim().length > 0;
      preview!.textContent = blumenGewaehlt ? text : leer;

      // Die Links tragen den Text mit, damit Messenger und Mailprogramm
      // vorausgefüllt aufgehen.
      if (whatsappLink) {
        const basis = whatsappLink.href.split('?')[0];
        whatsappLink.href = `${basis}?text=${encodeURIComponent(text)}`;
      }
      if (mailLink) {
        // Kein URLSearchParams: das kodiert Leerzeichen als „+“, und in einer
        // mailto-Adresse bleibt das ein Pluszeichen — die Mail käme mit
        // „Blumen:+Pfingstrosen“ an.
        const [basis, query = ''] = mailLink.href.split('?');
        const betreff = new URLSearchParams(query).get('subject') ?? '';
        mailLink.href =
          `${basis}?subject=${encodeURIComponent(betreff)}&body=${encodeURIComponent(text)}`;
      }
    }

    form.addEventListener('change', render);
    form.addEventListener('input', render);
    render();
  }
</script>
