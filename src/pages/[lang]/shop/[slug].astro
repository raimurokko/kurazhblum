---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Configurator from '../../../components/Configurator.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ContactChannels from '../../../components/ContactChannels.astro';
import { asset, LOCALES, path, t, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import {
  BOUQUETS,
  bouquetsByCategory,
  categoryBySlug,
  formatPrice,
  hasSizes,
  isOrderable,
  lowestPrice,
} from '../../../data/shop';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => BOUQUETS.map((bouquet) => ({ params: { lang, slug: bouquet.slug }, props: { bouquet } })));
}

const lang = Astro.params.lang as Locale;
const { bouquet } = Astro.props;
const _ = useTranslations(lang);

const name = t(bouquet.name, lang);
const blurb = t(bouquet.blurb, lang);
const category = categoryBySlug(bouquet.category);
const related = bouquetsByCategory(bouquet.category)
  .filter((entry) => entry.slug !== bouquet.slug)
  .concat(BOUQUETS.filter((entry) => entry.featured && entry.category !== bouquet.category))
  .slice(0, 3);

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: t(bouquet.description, lang),
  image: new URL(asset(bouquet.images[0]), Astro.site).href,
  brand: { '@type': 'Brand', name: 'KURAZHBLUM' },
  offers: bouquet.priceOnRequest
    ? undefined
    : hasSizes(bouquet)
    ? {
        '@type': 'AggregateOffer',
        priceCurrency: 'EUR',
        lowPrice: (Math.min(...Object.values(bouquet.prices!)) / 100).toFixed(2),
        highPrice: (Math.max(...Object.values(bouquet.prices!)) / 100).toFixed(2),
        availability: 'https://schema.org/InStock',
      }
    : {
        '@type': 'Offer',
        priceCurrency: 'EUR',
        price: ((bouquet.price ?? 0) / 100).toFixed(2),
        availability: 'https://schema.org/InStock',
      },
};
---

<BaseLayout lang={lang} title={name} description={blurb} route={`shop/${bouquet.slug}`} image={bouquet.images[0]}>
  <section class="section">
    <div class="wrap">
      <p class="crumb">
        <a href={path(lang, 'shop')}>{_('shop.back')}</a>
      </p>

      <div class="detail">
        <div class="detail-media">
          <div class="ph detail-ph" data-label={name}>
            <img
              data-product-image
              src={asset(bouquet.images[0])}
              alt={name}
              width="1000"
              height="1250"
              fetchpriority="high"
              decoding="async"
              onerror="this.remove()"
            />
            {bouquet.imagePlaceholder && <span class="platzhalter-marke">{_('common.placeholder')}</span>}
          </div>
        </div>

        <div class="detail-info">
          {category && <span class="kicker">{t(category.name, lang)}</span>}
          <h1>{name}</h1>
          <p class="detail-price">
            {
              bouquet.priceOnRequest ? (
                <span class="detail-price-saison">{_('product.seasonal.price')}</span>
              ) : (
                <>
                  {hasSizes(bouquet) && <span class="muted small">{_('shop.from')}</span>}
                  {formatPrice(lowestPrice(bouquet), lang)}
                </>
              )
            }
          </p>

          {bouquet.discountPercent && <p class="detail-flag">{_('product.discount')}</p>}
          <hr class="rule" />
          <p class="lead">{t(bouquet.description, lang)}</p>

          <dl class="spec">
            <dt>{_('cfg.summary')}</dt>
            <dd>{t(bouquet.composition, lang)}</dd>
            {bouquet.length && (
              <>
                <dt class="spec-more">{_('product.length')}</dt>
                <dd>{bouquet.length}</dd>
              </>
            )}
          </dl>

          {bouquet.variantsOnRequest && <p class="small muted detail-note">{_('product.variants')}</p>}
          <p class="small muted detail-note">{_('shop.seasonal')}</p>
        </div>
      </div>

      <div class="detail-cfg">
        {
          isOrderable(bouquet) ? (
            <Configurator lang={lang} bouquet={bouquet} />
          ) : (
            <div class="panel">
              <h2 class="saison-titel">{_('product.seasonal.title')}</h2>
              <p class="muted">{_('product.seasonal.text')}</p>
              <ContactChannels
                lang={lang}
                bare
                subject={name}
                message={`${_('product.seasonal.cta')}: ${name}`}
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--tint">
        <div class="wrap">
          <div class="section-head">
            <h2>{_('shop.related')}</h2>
          </div>
          <div class="grid grid--3">
            {related.map((entry) => (
              <ProductCard lang={lang} bouquet={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script type="application/ld+json" is:inline set:html={JSON.stringify(productJsonLd)} />
</BaseLayout>

<style>
  .crumb {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-6);
  }

  .crumb a {
    color: var(--cream-3);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--gold-lit);
  }

  .detail {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .detail-ph {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
  }

  .detail-ph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-price {
    font-family: var(--font-display), serif;
    font-size: min(2rem, 10vw);
    margin-bottom: var(--space-4);
  }

  .detail-price-saison {
    font-family: var(--font-body), sans-serif;
    font-size: 1rem;
    color: var(--gold-lit);
  }

  .saison-titel {
    font-size: min(1.5rem, 8vw);
    margin-bottom: var(--space-3);
  }

  .detail-flag {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: 0.35em 0.9em;
    border: 1px solid var(--gold-dim);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--gold-lit);
  }

  .detail-note {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: 1px solid var(--line-strong);
  }

  .spec-more {
    margin-top: var(--space-3);
  }

  .detail-price .small {
    font-family: var(--font-body), sans-serif;
    margin-right: 0.35em;
  }

  .spec {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .spec dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-lit);
    margin-bottom: var(--space-2);
  }

  .spec dd {
    margin: 0;
    color: var(--cream-2);
  }

  .detail-cfg {
    margin-top: clamp(2.5rem, 1rem + 4vw, 4rem);
    max-width: 46rem;
  }

  @media (width >= 56rem) {
    .detail {
      grid-template-columns: 1fr 1fr;
    }

    .detail-media {
      position: sticky;
      top: 6rem;
    }
  }
</style>
