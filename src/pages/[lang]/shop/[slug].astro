---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Configurator from '../../../components/Configurator.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ContactChannels from '../../../components/ContactChannels.astro';
import { asset, LOCALES, path, t, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import {
  BOUQUETS,
  bouquetsByCategory,
  categoryBySlug,
  formatPrice,
  hasSizes,
  imagesFor,
  isOrderable,
  lowestPrice,
  sizesOf,
} from '../../../data/shop';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => BOUQUETS.map((bouquet) => ({ params: { lang, slug: bouquet.slug }, props: { bouquet } })));
}

const lang = Astro.params.lang as Locale;
const { bouquet } = Astro.props;
const _ = useTranslations(lang);

const name = t(bouquet.name, lang);
const blurb = t(bouquet.blurb, lang);
const category = categoryBySlug(bouquet.category);
const related = bouquetsByCategory(bouquet.category)
  .filter((entry) => entry.slug !== bouquet.slug)
  .concat(BOUQUETS.filter((entry) => entry.featured && entry.category !== bouquet.category))
  .slice(0, 3);

/*
  Galerie. Gala hat den Dopamin-Strauß in M und L je zweimal fotografiert und
  die Päonienrosen ebenfalls — bislang sah niemand die zweite Aufnahme, weil
  jeder Aufrufer nur `images[0]` nahm. Bei einem Strauß, der nie gleich
  aussieht, ist die zweite Ansicht aber genau das Argument.

  Aufgebaut je Größe, weil `imagesBySize` das so vorgibt: M hat andere Fotos
  als XL. Ohne Größenstaffel liegt alles unter der Pseudo-Größe `fixed`, damit
  das Skript nur einen Fall kennt.
*/
const sizes = sizesOf(bouquet);
const galerie: Record<string, string[]> = sizes.length
  ? Object.fromEntries(sizes.map((size) => [size, imagesFor(bouquet, size).map((bild) => asset(bild))]))
  : { fixed: bouquet.images.map((bild) => asset(bild)) };

const startGroesse = sizes[0] ?? 'fixed';
/** Nur zeigen, wenn es in irgendeiner Größe wirklich mehr als ein Foto gibt. */
const hatGalerie = Object.values(galerie).some((bilder) => bilder.length > 1);

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: t(bouquet.description, lang),
  // Ohne Foto lieber gar kein `image` als eines, das es nicht gibt:
  // Ein toter Verweis in den strukturierten Daten ist schlechter als keiner.
  image: bouquet.images[0] ? new URL(asset(bouquet.images[0]), Astro.site).href : undefined,
  brand: { '@type': 'Brand', name: 'KURAZHBLUM' },
  offers: bouquet.priceOnRequest
    ? undefined
    : hasSizes(bouquet)
    ? {
        '@type': 'AggregateOffer',
        priceCurrency: 'EUR',
        lowPrice: (Math.min(...Object.values(bouquet.prices!)) / 100).toFixed(2),
        highPrice: (Math.max(...Object.values(bouquet.prices!)) / 100).toFixed(2),
        availability: 'https://schema.org/InStock',
      }
    : {
        '@type': 'Offer',
        priceCurrency: 'EUR',
        price: ((bouquet.price ?? 0) / 100).toFixed(2),
        availability: 'https://schema.org/InStock',
      },
};
---

<BaseLayout
  lang={lang}
  title={name}
  description={blurb}
  route={`shop/${bouquet.slug}`}
  image={bouquet.images[0]}
>
  <section class="section">
    <div class="wrap">
      <p class="crumb">
        <a href={path(lang, 'shop')}>{_('shop.back')}</a>
      </p>

      <div class="detail">
        <div class="detail-media">
          <div class="ph detail-ph" data-label={name}>
            {bouquet.images[0] && (
              <img
                data-product-image
                src={asset(bouquet.images[0])}
                alt={name}
                width="1000"
                height="1250"
                fetchpriority="high"
                decoding="async"
                onerror="this.remove()"
              />
            )}
            {bouquet.imagePending && (
              <span class="platzhalter-marke platzhalter-marke--folgt">{_('common.imagepending')}</span>
            )}
          </div>

          {
            hatGalerie && (
              <div class="galerie" data-galerie role="group" aria-label={_('product.gallery')}>
                {Object.entries(galerie).flatMap(([size, bilder]) =>
                  bilder.length > 1
                    ? bilder.map((bild, index) => (
                        <button
                          type="button"
                          class="galerie-thumb"
                          data-thumb
                          data-size={size}
                          hidden={size !== startGroesse}
                          aria-pressed={index === 0 ? 'true' : 'false'}
                        >
                          <img src={bild} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
                        </button>
                      ))
                    : [],
                )}
              </div>
            )
          }
        </div>

        <div class="detail-info">
          {category && <span class="kicker">{t(category.name, lang)}</span>}
          <h1>{name}</h1>
          <p class="detail-price">
            {
              bouquet.priceOnRequest ? (
                <span class="detail-price-saison">{_('product.seasonal.price')}</span>
              ) : (
                <>
                  {hasSizes(bouquet) && <span class="muted small">{_('shop.from')}</span>}
                  {formatPrice(lowestPrice(bouquet), lang)}
                </>
              )
            }
          </p>

          {bouquet.surprise && <p class="detail-flag">{_('product.discount')}</p>}
          <hr class="rule" />
          <p class="lead">{t(bouquet.description, lang)}</p>

          <dl class="spec">
            <dt>{_('cfg.summary')}</dt>
            <dd>{t(bouquet.composition, lang)}</dd>
            {bouquet.length && (
              <>
                <dt class="spec-more">{_('product.length')}</dt>
                <dd>{bouquet.length}</dd>
              </>
            )}
          </dl>

          {bouquet.variantsOnRequest && <p class="small muted detail-note">{_('product.variants')}</p>}
          {
            /*
              Der Hinweis auf eine ähnliche Alternative ist Galas eigener
              Wortlaut und gilt überall dort, wo jemand bestimmte Blumen
              bestellt hat. Beim Überraschungsstrauß gibt es nichts zu
              ersetzen: Dort wählt die Floristin ohnehin, was am Bestelltag am
              besten ist — das ist die Zusage, nicht der Ausnahmefall.
            */
            !bouquet.surprise && <p class="small muted detail-note">{_('shop.seasonal')}</p>
          }
        </div>
      </div>

      <div class="detail-cfg">
        {
          isOrderable(bouquet) ? (
            <Configurator lang={lang} bouquet={bouquet} />
          ) : (
            <div class="panel">
              <h2 class="saison-titel">{_('product.seasonal.title')}</h2>
              <p class="muted">{_('product.seasonal.text')}</p>
              <ContactChannels
                lang={lang}
                bare
                subject={name}
                message={`${_('product.seasonal.cta')}: ${name}`}
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--tint">
        <div class="wrap">
          <div class="section-head">
            <h2>{_('shop.related')}</h2>
          </div>
          <div class="grid grid--3">
            {related.map((entry) => (
              <ProductCard lang={lang} bouquet={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script type="application/ld+json" is:inline set:html={JSON.stringify(productJsonLd)} />
</BaseLayout>

<style>
  .crumb {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-6);
  }

  .crumb a {
    color: var(--cream-3);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--gold-lit);
  }

  .detail {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .detail-ph {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-bild);
  }

  /* Miniaturen. px statt rem, weil sie sonst mit der eingestellten Textgröße
     mitwachsen und bei 320 px das Layout sprengen — dieselbe Falle wie im
     Formularraster. Ein einzelnes Foto zeigt gar keine Leiste. */
  .galerie {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .galerie-thumb {
    width: 72px;
    height: 90px;
    flex: 0 0 auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-bild);
    background: var(--ink-3);
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.3s var(--ease);
  }

  .galerie-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .galerie-thumb[aria-pressed='true'] {
    border-color: var(--gold-lit);
  }

  .galerie-thumb:hover {
    border-color: var(--line-strong);
  }

  .galerie-thumb:focus-visible {
    outline: 2px solid var(--gold-lit);
    outline-offset: 3px;
  }

  .detail-ph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-price {
    font-family: var(--font-display), serif;
    font-size: min(2rem, 10vw);
    margin-bottom: var(--space-4);
  }

  .detail-price-saison {
    font-family: var(--font-body), sans-serif;
    font-size: 1rem;
    color: var(--gold-lit);
  }

  .saison-titel {
    font-size: min(1.5rem, 8vw);
    margin-bottom: var(--space-3);
  }

  .detail-flag {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: 0.35em 0.9em;
    border: 1px solid var(--gold-dim);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--gold-lit);
  }

  .detail-note {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: 1px solid var(--line-strong);
  }

  .spec-more {
    margin-top: var(--space-3);
  }

  .detail-price .small {
    font-family: var(--font-body), sans-serif;
    margin-right: 0.35em;
  }

  .spec {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .spec dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-lit);
    margin-bottom: var(--space-2);
  }

  .spec dd {
    margin: 0;
    color: var(--cream-2);
  }

  .detail-cfg {
    margin-top: clamp(2.5rem, 1rem + 4vw, 4rem);
    max-width: 46rem;
  }

  @media (width >= 56rem) {
    .detail {
      grid-template-columns: 1fr 1fr;
    }

    .detail-media {
      position: sticky;
      top: 6rem;
    }
  }
</style>

<script>
  /*
    Bildergalerie der Produktseite.

    Alle Miniaturen stehen serverseitig im Markup, je eine Gruppe pro Größe;
    das Skript blendet nur um. Das ist kein Umweg, sondern Notwendigkeit:
    Astros Scoped-CSS hängt an einem `data-astro-cid`-Attribut, das per
    `createElement` erzeugte Knöpfe nicht bekommen — sie stünden ungestylt und
    bildschirmfüllend da. Nebenbei funktioniert die Galerie so auch ohne
    JavaScript für die vorausgewählte Größe.

    Zwei Skripte schreiben auf dasselbe <img>: Der Konfigurator tauscht es beim
    Größenwechsel, weil Gala M, L und XL einzeln fotografiert hat. Beide
    schreiben denselben Wert — die Galerie setzt beim Wechsel ebenfalls auf das
    erste Foto der neuen Größe zurück. Wer bei L die zweite Ansicht offen hatte
    und auf XL wechselt, sähe sonst ein Foto, das es in XL gar nicht gibt.
  */
  const galerie = document.querySelector<HTMLElement>('[data-galerie]');
  const hauptbild = document.querySelector<HTMLImageElement>('[data-product-image]');

  if (galerie && hauptbild) {
    const thumbs = [...galerie.querySelectorAll<HTMLElement>('[data-thumb]')];

    function markiere(aktiv: HTMLElement | null): void {
      for (const thumb of thumbs) {
        thumb.setAttribute('aria-pressed', thumb === aktiv ? 'true' : 'false');
      }
    }

    function zeige(thumb: HTMLElement): void {
      const quelle = thumb.querySelector('img')?.getAttribute('src');
      if (!quelle || !hauptbild) return;
      hauptbild.setAttribute('src', quelle);
      hauptbild.removeAttribute('srcset');
      markiere(thumb);
    }

    function fuerGroesse(size: string): void {
      let erster: HTMLElement | null = null;
      for (const thumb of thumbs) {
        const passt = thumb.dataset.size === size;
        thumb.hidden = !passt;
        if (passt && !erster) erster = thumb;
      }
      // Eine Leiste mit einem einzigen Knopf hilft niemandem.
      galerie!.hidden = erster === null;
      markiere(erster);
    }

    galerie.addEventListener('click', (event) => {
      const thumb = (event.target as HTMLElement).closest<HTMLElement>('[data-thumb]');
      if (thumb) zeige(thumb);
    });

    for (const eingabe of document.querySelectorAll<HTMLInputElement>('input[name="size"]')) {
      eingabe.addEventListener('change', () => {
        if (eingabe.checked) fuerGroesse(eingabe.value);
      });
    }

    const gewaehlt = document.querySelector<HTMLInputElement>('input[name="size"]:checked');
    fuerGroesse(gewaehlt?.value ?? 'fixed');
  }
</script>
