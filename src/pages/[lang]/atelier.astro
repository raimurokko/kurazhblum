---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstagramGrid from '../../components/InstagramGrid.astro';
import { asset, localePaths, path, t, type I18nText, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../data/site';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const _ = useTranslations(lang);

/*
  ⚠️ TODO — persönliche Geschichte
  Die Absätze hier beschreiben bewusst nur die Arbeitsweise, keine Biografie.
  Galas eigene Geschichte (Ausbildung, Weg nach Berlin, warum Blumen) gehört
  hierher, aber sie muss von ihr selbst kommen — nichts davon erfinden.
*/
const paragraphs: I18nText[] = [
  {
    de: '„Kurazh“ heißt Mut und Kreativität. Genau das braucht ein Strauß, damit er bei der beschenkten Person ein Wow auslöst.',
    uk: '«Кураж» — це сміливість і креативність. Саме це потрібно букету, щоб викликати вау-емоцію в того, кому його дарують.',
    en: '“Kurazh” means courage and creativity. That is exactly what a bouquet needs in order to produce a wow in the person receiving it.',
    ru: '«Кураж» — это смелость и креативность. Именно это нужно букету, чтобы вызвать вау-эмоции у получателя.',
  },
  {
    de: 'Im Atelier gibt es kein Lager. Ich kaufe morgens ein, binde tagsüber und liefere am selben oder am nächsten Tag — deshalb halten meine Sträuße lange, denn bei der Frische gehe ich nie einen Kompromiss ein. Die Zusammensetzung stimme ich mit jeder Kundin und jedem Kunden einzeln ab.',
    uk: 'В ательє немає складу. Закуповуюся вранці, збираю вдень і доставляю того ж або наступного дня — тому мої букети радують довго, адже у питаннях свіжості я ніколи не йду на компроміс. Склад букета завжди узгоджую з кожним клієнтом індивідуально.',
    en: 'There is no warehouse at the atelier. I shop in the morning, tie during the day and deliver the same or the next day — which is why my bouquets last, because on freshness I never compromise. The composition is always agreed individually with each customer.',
    ru: 'В ателье нет склада. Я закупаюсь утром, собираю днём и доставляю в тот же или на следующий день, потому мои букеты будут радовать вас долго, ведь в вопросах свежести я никогда не иду на компромисс. Состав букета всегда согласовывается с каждым клиентом в индивидуальном порядке.',
  },
  {
    de: 'Ist die Sorte, die Sie bestellt haben, nicht zu bekommen, melde ich mich bei Ihnen und schlage eine Alternative vor — so können Sie sicher sein, dass der Strauß Ihren Erwartungen entspricht. Vor der Lieferung können Sie ein Foto anfordern; sagen Sie das einfach bei der Bestellung. Und wenn Sie eine persönliche Nachricht mitschicken möchten, schreibe ich Ihnen die Karte gern von Hand.',
    uk: 'Якщо сорту, який ви замовили, немає в наявності, я звʼяжуся з вами та запропоную альтернативу — так ви можете бути впевнені, що букет відповідатиме вашим очікуванням. Перед доставкою ви можете попросити фото букета; просто зазначте це при оформленні замовлення. А якщо хочете надіслати персональне послання, я гарно підпишу листівку від вас.',
    en: 'If the variety you ordered is not available, I get in touch and suggest an alternative — so you can be sure the bouquet will match your expectations. Before delivery you can ask for a photo of it; just say so when you order. And if you want to send a personal message, I will gladly write the card by hand on your behalf.',
    ru: 'Если того сорта, который вы заказали, нет в наличии, я свяжусь с вами чтобы предложить альтернативу, поэтому вы можете быть уверены в том, что букет будет полностью соответствовать вашим ожиданиям. Перед доставкой вы можете запросить фото букета — это надо будет указать при оформлении заказа, кроме того я могу красиво подписать открытку от вас, если вы хотите послать персонализированное сообщение получателю цветов.',
  },
];

const facts: { label: I18nText; value: I18nText }[] = [
  {
    label: { de: 'Atelier', uk: 'Ательє', en: 'Atelier', ru: 'Ателье' },
    value: {
      de: 'Berlin — Besuch nach Vereinbarung',
      uk: 'Берлін — візит за домовленістю',
      en: 'Berlin — visits by appointment',
      ru: 'Берлин — визит по договорённости',
    },
  },
  {
    label: { de: 'Sprachen', uk: 'Мови', en: 'Languages', ru: 'Языки' },
    value: {
      de: 'Deutsch, Ukrainisch, Englisch, Russisch',
      uk: 'Німецька, українська, англійська, російська',
      en: 'German, Ukrainian, English, Russian',
      ru: 'Немецкий, украинский, английский, русский',
    },
  },
  {
    label: { de: 'Liefergebiet', uk: 'Зона доставки', en: 'Delivery area', ru: 'Зона доставки' },
    value: {
      de: 'Berlin — Tarifbereich A und B',
      uk: 'Берлін — тарифні зони A і B',
      en: 'Berlin — fare zones A and B',
      ru: 'Берлин — тарифные зоны A и B',
    },
  },
];
---

<BaseLayout lang={lang} title={_('atelier.title')} description={t(paragraphs[0], lang)} route="atelier">
  <section class="section">
    <div class="wrap about">
      <div>
        <span class="kicker">{_('atelier.kicker')}</span>
        <h1>{_('atelier.title')}</h1>
        {paragraphs.map((paragraph) => <p class="lead">{t(paragraph, lang)}</p>)}

        <dl class="facts">
          {
            facts.map((fact) => (
              <div>
                <dt>{t(fact.label, lang)}</dt>
                <dd>{t(fact.value, lang)}</dd>
              </div>
            ))
          }
        </dl>

        <div class="about-actions">
          <a class="btn btn--primary" href={path(lang, 'kontakt')}>{_('nav.contact')}</a>
          <a class="btn btn--ghost" href={path(lang, 'workshops')}>{_('nav.workshops')}</a>
        </div>
      </div>

      <figure class="about-figure">
        <div class="ph about-ph" data-label={site.nameFull}>
          <img src={asset("/images/atelier/portrait.jpg")} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
        </div>
      </figure>
    </div>
  </section>

  <InstagramGrid lang={lang} />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .facts {
    margin: clamp(2rem, 1rem + 2vw, 3rem) 0;
    display: grid;
    gap: var(--space-3);
  }

  .facts > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-lit);
  }

  .facts dt,
  .facts dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .facts dd {
    margin: 0;
    color: var(--cream-2);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .about-figure {
    margin: 0;
  }

  .about-ph {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
  }

  .about-ph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (width >= 56rem) {
    .about {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .about-figure {
      position: sticky;
      top: 6rem;
    }
  }
</style>
