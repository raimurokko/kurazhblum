---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { asset, localePaths, t, type I18nText, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const _ = useTranslations(lang);

const services: { title: I18nText; text: I18nText }[] = [
  {
    title: {
      de: 'Persönliche Floristik',
      uk: 'Персональна флористика',
      en: 'Personal florals',
      ru: 'Персональная флористика',
    },
    text: {
      de: 'Brautstrauß, Anstecker, Haarschmuck — oder bei Firmenanlässen der Strauß für die Rednerin und die Ansteckblume fürs Team. Alles wird an der Person ausgerichtet, nicht an einem Katalogbild.',
      uk: 'Букет нареченої, бутоньєрки, прикраса для волосся — або на корпоративних заходах букет для спікерки та бутоньєрки для команди. Усе підбирається під людину, а не під картинку з каталогу.',
      en: 'Bridal bouquet, buttonholes, hairpieces — or, at company occasions, the bouquet for the speaker and buttonholes for the team. Everything is built around the person, not a catalogue photo.',
      ru: 'Букет невесты, бутоньерки, украшение для волос — или на корпоративных мероприятиях букет для спикера и бутоньерки для команды. Всё подбирается под человека, а не под картинку из каталога.',
    },
  },
  {
    title: {
      de: 'Bögen, Fotozonen, Bühne',
      uk: 'Арки, фотозони, сцена',
      en: 'Arches, photo backdrops, stage',
      ru: 'Арки, фотозоны, сцена',
    },
    text: {
      de: 'Ein Blumenbogen oder eine Fotozone für die Hochzeit oder jede andere Veranstaltung. Aufbau vor Ort, lange bevor die ersten Gäste kommen.',
      uk: 'Створення квіткової арки або фотозони для весілля чи будь-якої іншої події. Монтаж на місці, задовго до приходу гостей.',
      en: 'A flower arch or a photo backdrop for a wedding or any other event. Set up on site, long before the first guests arrive.',
      ru: 'Создание цветочной арки, фотозоны для свадьбы или любого другого мероприятия. Монтаж на месте, задолго до прихода гостей.',
    },
  },
  {
    title: {
      de: 'Dekoration',
      uk: 'Декорація',
      en: 'Decoration',
      ru: 'Декорация',
    },
    text: {
      de: 'Florale Dekoration für Büros und Salons, auf Wunsch auch als wöchentliches oder monatliches Abonnement.',
      uk: 'Квіткова декорація для офісів і салонів, за бажанням також у форматі щотижневої або щомісячної підписки.',
      en: 'Floral decoration for offices and showrooms, on request also as a weekly or monthly subscription.',
      ru: 'Цветочная декорация для офисов и салонов, так же в формате еженедельной или ежемесячной подписки.',
    },
  },
  {
    title: {
      de: 'Auf- und Abbau',
      uk: 'Монтаж і демонтаж',
      en: 'Set-up & take-down',
      ru: 'Монтаж и демонтаж',
    },
    text: {
      de: 'Wir bauen auf und räumen wieder ab — auch nachts. Sie müssen sich am nächsten Morgen um nichts kümmern.',
      uk: 'Ми монтуємо та прибираємо — навіть уночі. Наступного ранку вам не треба нічим перейматися.',
      en: 'We set up and clear away again — at night too. You have nothing to deal with the next morning.',
      ru: 'Мы монтируем и убираем — в том числе ночью. На следующее утро вам не нужно ни о чём заботиться.',
    },
  },
];

const steps: { title: I18nText; text: I18nText }[] = [
  {
    title: { de: 'Anfrage', uk: 'Запит', en: 'Enquiry', ru: 'Запрос' },
    text: {
      de: 'Sie schicken Datum, Ort und ein paar Bilder, die Ihnen gefallen. Ich antworte innerhalb von 24 Stunden, ob der Termin frei ist.',
      uk: 'Ви надсилаєте дату, місце та кілька зображень, які вам подобаються. Відповідаю протягом 24 годин, чи вільна дата.',
      en: 'You send the date, the venue and a few images you like. I reply within 24 hours whether the date is free.',
      ru: 'Вы присылаете дату, место и несколько картинок, которые вам нравятся. Отвечаю в течение 24 часов, свободна ли дата.',
    },
  },
  {
    title: { de: 'Gespräch', uk: 'Розмова', en: 'Conversation', ru: 'Разговор' },
    text: {
      de: 'Eine Stunde per Video oder im Atelier. Danach wissen wir beide, ob es passt — kostenlos und unverbindlich.',
      uk: 'Година по відео або в ательє. Після цього ми обоє знаємо, чи підходимо одне одному — безкоштовно та без зобовʼязань.',
      en: 'An hour by video or at the atelier. After that we both know whether it fits — free and without obligation.',
      ru: 'Час по видео или в ателье. После этого мы оба понимаем, подходим ли друг другу — бесплатно и без обязательств.',
    },
  },
  {
    title: { de: 'Konzept & Angebot', uk: 'Концепція та пропозиція', en: 'Concept & quote', ru: 'Концепция и предложение' },
    text: {
      de: 'Sie bekommen eine Skizze für jeden Bereich und ein festes Angebot. Erst danach wird etwas verbindlich.',
      uk: 'Ви отримуєте ескіз для кожної зони та фіксовану пропозицію. Лише після цього щось стає обовʼязковим.',
      en: 'You receive a sketch for each area and a fixed quote. Only then does anything become binding.',
      ru: 'Вы получаете эскиз для каждой зоны и фиксированное предложение. Только после этого что-то становится обязательным.',
    },
  },
  {
    title: { de: 'Tag X', uk: 'День Х', en: 'Day X', ru: 'День Х' },
    text: {
      de: 'Wir sind vor Ihnen da und bauen nach den letzten Gästen wieder ab. Den Brautstrauß können Sie am Vorabend abholen, oder ich bringe ihn vorab zur Location.',
      uk: 'Ми на місці раніше за вас і демонтуємо після останніх гостей. Букет нареченої ви можете забрати напередодні ввечері, або я привезу його заздалегідь на локацію.',
      en: 'We are there before you and take everything down after the last guests. You can collect the bridal bouquet the evening before, or I bring it to the venue in advance.',
      ru: 'Мы на месте раньше вас и производим демонтаж после последних гостей. Букет невесты вы можете забрать накануне вечером, за день до события, или же я заранее привезу его на площадку.',
    },
  },
];
---

<BaseLayout lang={lang} title={_('weddings.title')} description={_('weddings.intro')} route="hochzeiten">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{_('weddings.kicker')}</span>
        <h1>{_('weddings.title')}</h1>
        <p class="lead">{_('weddings.intro')}</p>
      </div>

      <div class="ph hero-band" data-label={_('weddings.kicker')}>
        <img src={asset('/images/weddings/hero.webp')} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head">
        <h2>{_('weddings.services')}</h2>
      </div>
      <div class="grid grid--2">
        {
          services.map((service) => (
            <div class="panel">
              <h3>{t(service.title, lang)}</h3>
              <p class="muted">{t(service.text, lang)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/*
    Zwei Bildflächen direkt hinter den Leistungen, weil sie genau die zwei
    Hälften zeigen, die der Abschnitt darüber aufzählt: der Bogen für die
    Trauung, die Tischgestaltung für den Saal. Bis hierher trug die Seite ein
    einziges Foto, und dasselbe lief zusätzlich auf der Startseite.
  */}
  <section class="section">
    <div class="wrap">
      <div class="grid grid--2 weddings-galerie">
        <figure>
          <div class="ph galerie-ph" data-label={_('weddings.gallery.arch')}>
            <img
              src={asset('/images/weddings/bogen.webp')}
              alt=""
              loading="lazy"
              decoding="async"
              onerror="this.remove()"
            />
          </div>
          <figcaption class="small muted">{_('weddings.gallery.arch')}</figcaption>
        </figure>
        <figure>
          <div class="ph galerie-ph" data-label={_('weddings.gallery.table')}>
            <img
              src={asset('/images/weddings/tisch.webp')}
              alt=""
              loading="lazy"
              decoding="async"
              onerror="this.remove()"
            />
          </div>
          <figcaption class="small muted">{_('weddings.gallery.table')}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{_('weddings.process')}</h2>
      </div>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <span class="step-num">{String(index + 1).padStart(2, '0')}</span>
              <h3>{t(step.title, lang)}</h3>
              <p class="muted small">{t(step.text, lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap wrap-narrow">
      <h2>{_('weddings.pricing.title')}</h2>
      <p class="lead">{_('weddings.pricing.text')}</p>
    </div>
  </section>

  <section class="section" id="anfrage">
    <div class="wrap wrap-narrow">
      <div class="section-head">
        <h2>{_('weddings.inquire')}</h2>
      </div>
      {/* Kein ContactChannels davor: Das Formular trägt WhatsApp, E-Mail und
          Instagram inzwischen selbst — und dort gehen die Angaben mit. */}
      <InquiryForm lang={lang} topic="wedding" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Das Foto ist hochformatig; ein 21:9-Band würde davon nur einen schmalen
     Streifen zeigen. 16:9 und ein Bildausschnitt etwas oberhalb der Mitte
     lassen Hände und Strauß im Bild. */
  .hero-band {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-bild);
  }

  /* Hochformat, weil beide Aufnahmen hochkant sind — ein Querformat daraus
     zu schneiden hieße, den halben Bogen wegzunehmen. */
  .weddings-galerie figure {
    margin: 0;
  }

  .galerie-ph {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-bild);
    margin-bottom: var(--space-2);
  }

  .galerie-ph img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-band img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 66%;
  }

  .anfrage-trenner {
    width: 100%;
    margin: var(--space-6) 0;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 0.5rem + 2vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    counter-reset: step;
  }

  .step {
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-4);
  }

  .step-num {
    display: block;
    font-family: var(--font-display), serif;
    font-size: 1.6rem;
    color: var(--gold);
    margin-bottom: var(--space-3);
  }

  .step h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .step p {
    margin: 0;
  }
</style>
