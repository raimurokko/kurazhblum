---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import ContactChannels from '../../components/ContactChannels.astro';
import { asset, localePaths, t, type I18nText, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const _ = useTranslations(lang);

const services: { title: I18nText; text: I18nText }[] = [
  {
    title: {
      de: 'Persönliche Floristik',
      uk: 'Персональна флористика',
      en: 'Personal florals',
      ru: 'Персональная флористика',
    },
    text: {
      de: 'Brautstrauß, Anstecker, Haarschmuck — oder bei Firmenanlässen der Strauß für die Rednerin und die Ansteckblume fürs Team. Alles wird an der Person ausgerichtet, nicht an einem Katalogbild.',
      uk: 'Букет нареченої, бутоньєрки, прикраса для волосся — або на корпоративних заходах букет для спікерки та бутоньєрки для команди. Усе підбирається під людину, а не під картинку з каталогу.',
      en: 'Bridal bouquet, buttonholes, hairpieces — or, at company occasions, the bouquet for the speaker and buttonholes for the team. Everything is built around the person, not a catalogue photo.',
      ru: 'Букет невесты, бутоньерки, украшение для волос — или на корпоративных мероприятиях букет для спикера и бутоньерки для команды. Всё подбирается под человека, а не под картинку из каталога.',
    },
  },
  {
    title: {
      de: 'Zeremonie, Bühne, Empfang',
      uk: 'Церемонія, сцена, зустріч гостей',
      en: 'Ceremony, stage, reception',
      ru: 'Церемония, сцена, приём',
    },
    text: {
      de: 'Trauungsbogen und Stuhlreihen bei der Hochzeit; Bühne, Rednerpult, Fotowand und Empfangstresen bei Firmenanlässen und Eröffnungen. Aufbau vor Ort, rechtzeitig vor den ersten Gästen.',
      uk: 'Весільна арка та ряди стільців на весіллі; сцена, трибуна, фотозона та стійка реєстрації на корпоративах і відкриттях. Монтаж на місці, завчасно до приходу гостей.',
      en: 'Ceremony arch and aisle rows at a wedding; stage, lectern, photo wall and reception desk at company occasions and openings. Set up on site, well before the first guests arrive.',
      ru: 'Свадебная арка и ряды стульев на свадьбе; сцена, трибуна, фотозона и стойка регистрации на корпоративах и открытиях. Монтаж на месте, задолго до прихода гостей.',
    },
  },
  {
    title: {
      de: 'Tische & Raum',
      uk: 'Столи та зал',
      en: 'Tables & room',
      ru: 'Столы и зал',
    },
    text: {
      de: 'Tischläufer aus Blumen, einzelne Gestecke, Kerzen, Eingang und Bar — abgestimmt auf Ihre Location statt gegen sie. Für Geschäfte und Büros auch als wiederkehrende Gestaltung im Wochen- oder Monatsrhythmus.',
      uk: 'Квіткові доріжки, окремі композиції, свічки, вхід і бар — у злагоді з вашою локацією, а не всупереч їй. Для магазинів та офісів також як регулярне оформлення щотижня або щомісяця.',
      en: 'Floral runners, individual arrangements, candles, entrance and bar — tuned to your venue rather than against it. For shops and offices also as a recurring arrangement, weekly or monthly.',
      ru: 'Цветочные дорожки, отдельные композиции, свечи, вход и бар — в согласии с вашей площадкой, а не вопреки ей. Для магазинов и офисов также как регулярное оформление еженедельно или ежемесячно.',
    },
  },
  {
    title: {
      de: 'Auf- und Abbau',
      uk: 'Монтаж і демонтаж',
      en: 'Set-up & take-down',
      ru: 'Монтаж и демонтаж',
    },
    text: {
      de: 'Wir bauen auf und räumen wieder ab — auch nachts. Sie müssen sich am nächsten Morgen um nichts kümmern.',
      uk: 'Ми монтуємо та прибираємо — навіть уночі. Наступного ранку вам не треба нічим перейматися.',
      en: 'We set up and clear away again — at night too. You have nothing to deal with the next morning.',
      ru: 'Мы монтируем и убираем — в том числе ночью. На следующее утро вам не нужно ни о чём заботиться.',
    },
  },
];

const steps: { title: I18nText; text: I18nText }[] = [
  {
    title: { de: 'Anfrage', uk: 'Запит', en: 'Enquiry', ru: 'Запрос' },
    text: {
      de: 'Sie schicken Datum, Ort und ein paar Bilder, die Ihnen gefallen. Ich antworte innerhalb von 24 Stunden, ob der Termin frei ist.',
      uk: 'Ви надсилаєте дату, місце та кілька зображень, які вам подобаються. Відповідаю протягом 24 годин, чи вільна дата.',
      en: 'You send the date, the venue and a few images you like. I reply within 24 hours whether the date is free.',
      ru: 'Вы присылаете дату, место и несколько картинок, которые вам нравятся. Отвечаю в течение 24 часов, свободна ли дата.',
    },
  },
  {
    title: { de: 'Gespräch', uk: 'Розмова', en: 'Conversation', ru: 'Разговор' },
    text: {
      de: 'Eine Stunde per Video oder im Atelier. Danach wissen wir beide, ob es passt — kostenlos und unverbindlich.',
      uk: 'Година по відео або в ательє. Після цього ми обоє знаємо, чи підходимо одне одному — безкоштовно та без зобовʼязань.',
      en: 'An hour by video or at the atelier. After that we both know whether it fits — free and without obligation.',
      ru: 'Час по видео или в ателье. После этого мы оба понимаем, подходим ли друг другу — бесплатно и без обязательств.',
    },
  },
  {
    title: { de: 'Konzept & Angebot', uk: 'Концепція та пропозиція', en: 'Concept & quote', ru: 'Концепция и предложение' },
    text: {
      de: 'Sie bekommen eine Farbkarte, eine Skizze pro Bereich und ein festes Angebot. Erst danach wird etwas verbindlich.',
      uk: 'Ви отримуєте кольорову карту, ескіз для кожної зони та фіксовану пропозицію. Лише після цього щось стає обовʼязковим.',
      en: 'You receive a colour card, a sketch per area and a fixed quote. Only then does anything become binding.',
      ru: 'Вы получаете цветовую карту, эскиз для каждой зоны и фиксированное предложение. Только после этого что-то становится обязательным.',
    },
  },
  {
    title: { de: 'Der Tag', uk: 'День', en: 'The day', ru: 'День' },
    text: {
      de: 'Wir sind vor Ihnen da und gehen nach den letzten Gästen. Bei Hochzeiten kommt der Brautstrauß am Morgen zu Ihnen, nicht in die Location.',
      uk: 'Ми на місці раніше за вас і йдемо після останніх гостей. На весіллі букет нареченої привозимо вранці вам, а не в локацію.',
      en: 'We arrive before you and leave after the last guests. At weddings the bridal bouquet comes to you in the morning, not to the venue.',
      ru: 'Мы на месте раньше вас и уходим после последних гостей. На свадьбе букет невесты привозим утром вам, а не на площадку.',
    },
  },
];
---

<BaseLayout lang={lang} title={_('weddings.title')} description={_('weddings.intro')} route="hochzeiten">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{_('weddings.kicker')}</span>
        <h1>{_('weddings.title')}</h1>
        <p class="lead">{_('weddings.intro')}</p>
      </div>

      <div class="ph hero-band" data-label={_('weddings.kicker')}>
        <img src={asset('/images/weddings/hero.png')} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
        <span class="platzhalter-marke">{_('common.placeholder')}</span>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head">
        <h2>{_('weddings.services')}</h2>
      </div>
      <div class="grid grid--2">
        {
          services.map((service) => (
            <div class="panel">
              <h3>{t(service.title, lang)}</h3>
              <p class="muted">{t(service.text, lang)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{_('weddings.process')}</h2>
      </div>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <span class="step-num">{String(index + 1).padStart(2, '0')}</span>
              <h3>{t(step.title, lang)}</h3>
              <p class="muted small">{t(step.text, lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap wrap-narrow">
      <h2>{_('weddings.pricing.title')}</h2>
      <p class="lead">{_('weddings.pricing.text')}</p>
    </div>
  </section>

  <section class="section" id="anfrage">
    <div class="wrap wrap-narrow">
      <div class="section-head">
        <h2>{_('weddings.inquire')}</h2>
      </div>
      <ContactChannels lang={lang} subject={_('weddings.inquire')} />
      <hr class="rule anfrage-trenner" />
      <InquiryForm lang={lang} topic="wedding" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Das Foto ist hochformatig; ein 21:9-Band würde davon nur einen schmalen
     Streifen zeigen. 16:9 und ein Bildausschnitt etwas oberhalb der Mitte
     lassen Hände und Strauß im Bild. */
  .hero-band {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
  }

  .hero-band img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 66%;
  }

  .anfrage-trenner {
    width: 100%;
    margin: var(--space-6) 0;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 0.5rem + 2vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    counter-reset: step;
  }

  .step {
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-4);
  }

  .step-num {
    display: block;
    font-family: var(--font-display), serif;
    font-size: 1.6rem;
    color: var(--gold);
    margin-bottom: var(--space-3);
  }

  .step h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .step p {
    margin: 0;
  }
</style>
