# Kopie als `.env` anlegen und ausfüllen. `.env` gehört NICHT ins Repository.

# — Zahlungen (Stripe) ————————————————————————————————————————————————
# Ohne diesen Schlüssel läuft die Website vollständig, nur die Kasse
# antwortet mit 503. Zum Testen den Schlüssel aus dem Testmodus nehmen
# (beginnt mit sk_test_), erst zum Livegang auf sk_live_ wechseln.
STRIPE_SECRET_KEY=sk_test_...

# — Anfrageformulare (Resend) —————————————————————————————————————————
# https://resend.com — kostenloses Kontingent reicht für den Anfang.
# Die Absenderdomain muss dort einmal verifiziert werden.
RESEND_API_KEY=re_...
INQUIRY_TO=hallo@kurazhblum.de
INQUIRY_FROM=KURAZHBLUM <anfrage@kurazhblum.de>
